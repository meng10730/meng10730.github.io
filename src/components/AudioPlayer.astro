---
// AudioPlayer.astro - 古風背景音樂播放器
---

<div class="audio-player-container" id="audio-player-ui" transition:persist="audio-player-ui">
  <!-- 背景音樂曲目跑馬燈 -->
  <div class="music-marquee-container" id="music-marquee-container">
    <span class="music-note-icon">🎵</span>
    <div class="music-marquee-inner">
      <span class="music-marquee-content" id="music-marquee-content"></span>
    </div>
  </div>

  <!-- 提示文字，懸停時顯示 -->
  <span class="player-tooltip" id="player-tooltip">開啟背景音樂</span>
  
  <!-- 背景音樂控制鈕 -->
  <button class="music-toggle-btn" id="music-toggle" aria-label="切換背景音樂">
    <!-- 水墨音波跳動線條 -->
    <div class="wave-bar"></div>
    <div class="wave-bar"></div>
    <div class="wave-bar"></div>
    <div class="wave-bar"></div>
  </button>

  <!-- 按鍵音效控制鈕 -->
  <button class="sfx-toggle-btn-global" id="sfx-toggle-global" aria-label="切換按鍵音效">
    <span class="sfx-status-icon" id="sfx-status-icon">🔔</span>
  </button>

  <!-- 動畫控制鈕 -->
  <button class="motion-toggle-btn-global" id="motion-toggle-global" aria-label="切換動畫效果" title="切換全站動畫效果">
    <span class="motion-status-text" id="motion-status-text">動</span>
  </button>
  
  <!-- 隱藏的背景音樂音訊元素 -->
  <audio 
    id="main-bgm" 
    src="/audio/子夜寄君書木管重奏.ogg" 
    loop 
    preload="none"
    data-astro-transition-persist="main-bgm-player"
  ></audio>

  <!-- 隱藏的作品試聽音訊元素 -->
  <audio 
    id="preview-audio" 
    preload="none"
    data-astro-transition-persist="preview-audio-player"
  ></audio>

  <!-- 全站常駐底欄試聽播放條 (Dock Player) -->
  <div class="music-dock-bar" id="music-dock-bar">
    <div class="dock-inner">
      <div class="dock-info">
        <span class="dock-badge">試聽</span>
        <div class="dock-text-group">
          <div class="dock-title-row">
            <span class="dock-song-title" id="dock-song-title">曲目名稱</span>
            <span class="dock-origin-source" id="dock-origin-source"></span>
          </div>
          <div class="dock-progress-wrapper">
            <div class="dock-progress-bar" id="dock-progress-bar">
              <div class="dock-progress-fill" id="dock-progress-fill"></div>
            </div>
            <span class="dock-time-text" id="dock-time-text">00:00 / 00:00</span>
          </div>
        </div>
      </div>
      <div class="dock-actions">
        <button class="dock-btn play-pause-btn" id="dock-play-pause-btn" aria-label="播放或暫停試聽">
          <span class="dock-btn-icon" id="dock-play-icon">▶</span>
        </button>
        <button class="dock-btn close-btn" id="dock-close-btn" aria-label="關閉試聽列" title="關閉試聽">
          ✕
        </button>
      </div>
    </div>
  </div>
</div>

<!-- 《活俠傳》背景音樂自訂教學 (註解形式，供使用者查閱) -->
<!-- 
  【如何替換為《活俠傳》背景音樂？】
  1. 將您擁有的《活俠傳》音樂檔案（如：唐門日常.mp3 或 聽雨.mp3）命名為 `bgm.mp3`。
  2. 將檔案放入專案的 `public/` 目錄下（建議在 public 下建置 `audio/` 資料夾，放置為 `public/audio/bgm.mp3`）。
  3. 修改上方 <audio> 標籤中的 src 屬性為：
     src="/audio/bgm.mp3" (若有設定 base 路徑，請注意寫法，如："/repo-name/audio/bgm.mp3")。
  4. 重新建置並上傳即可！
-->

<style>
  .audio-player-container {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    z-index: 999;
  }

  /* 跑馬燈容器 - 自適應寬度，水墨邊框，宣紙底色 */
  .music-marquee-container {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
    background: rgba(253, 252, 247, 0.95);
    border: 0px solid var(--color-border);
    padding: 0;
    border-radius: 20px;
    height: 32px;
    font-size: 0.8rem;
    font-family: var(--font-serif);
    color: var(--color-ink-grey);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
    transition: max-width 0.5s cubic-bezier(0.25, 0.8, 0.25, 1), opacity 0.5s ease, padding 0.5s ease, border-width 0.5s ease, margin-right 0.5s ease;
    pointer-events: none;
  }

  .music-marquee-container.visible {
    max-width: 220px; /* 最大展開寬度 */
    opacity: 1;
    padding: 0 0.8rem;
    border: 1.5px solid var(--color-ink-black);
    margin-right: 0.2rem;
    pointer-events: auto;
  }

  /* 漸隱水墨邊緣遮罩 */
  .music-marquee-inner {
    overflow: hidden;
    white-space: nowrap;
    display: flex;
    flex: 1;
    width: max-content;
    mask-image: linear-gradient(to right, transparent, white 8px, white 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, white 8px, white 92%, transparent);
  }

  .music-marquee-content {
    display: inline-block;
    white-space: nowrap;
  }

  /* 8 秒滾動完一輪，僅當確定需要滾動且 visible 時才啟用 */
  .music-marquee-container.visible.should-scroll .music-marquee-content {
    animation: marquee-scroll 8s linear infinite;
  }

  /* 微幅震動的古風音符 */
  .music-note-icon {
    display: inline-block;
    animation: note-bounce 1.5s ease-in-out infinite alternate;
  }

  @keyframes note-bounce {
    0% {
      transform: translateY(0) rotate(-5deg);
    }
    100% {
      transform: translateY(-2px) rotate(5deg);
    }
  }

  @keyframes marquee-scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0); /* 雙生文字平移一半實現無縫循環 */
    }
  }

  .player-tooltip {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    color: var(--color-ink-grey);
    background: rgba(253, 252, 247, 0.9);
    border: 1px solid var(--color-border);
    padding: 0.3rem 0.7rem;
    border-radius: 4px;
    opacity: 0;
    transform: translateX(10px);
    transition: var(--transition-smooth);
    pointer-events: none;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
  }

  .audio-player-container:hover .player-tooltip {
    opacity: 1;
    transform: translateX(0);
  }

  /* 控制按鈕，設計成水墨圓章外觀 */
  .music-toggle-btn, .sfx-toggle-btn-global {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(253, 252, 247, 0.85);
    border: 1.5px solid var(--color-ink-black);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    transition: var(--transition-smooth);
  }

  .music-toggle-btn {
    gap: 3px;
    padding: 0 10px;
  }

  .sfx-toggle-btn-global {
    font-size: 1.25rem;
    color: var(--color-ink-black);
  }

  .music-toggle-btn:hover, .sfx-toggle-btn-global:hover {
    background: var(--color-paper-light);
    border-color: var(--color-mountain-cyan);
    transform: scale(1.05);
  }

  /* 停用狀態的按鍵音按鈕，呈灰墨色 */
  .sfx-toggle-btn-global.muted {
    border-color: rgba(92, 92, 92, 0.35);
    color: var(--color-ink-grey);
    background: rgba(240, 240, 240, 0.65);
    box-shadow: none;
  }

  /* 極簡音波跳動線條 */
  .wave-bar {
    width: 3px;
    height: 8px;
    background-color: var(--color-ink-black);
    border-radius: 2px;
    transition: var(--transition-fast);
  }

  /* 播放時的音波跳動動畫 */
  .playing .wave-bar {
    background-color: var(--color-mountain-cyan);
    animation: bounce 1.2s ease-in-out infinite alternate;
  }

  /* 為每個音波條設定不同的動畫延遲，形成起伏感 */
  .playing .wave-bar:nth-child(1) {
    animation-delay: 0.1s;
    height: 18px;
  }
  .playing .wave-bar:nth-child(2) {
    animation-delay: 0.4s;
    height: 24px;
  }
  .playing .wave-bar:nth-child(3) {
    animation-delay: 0.2s;
    height: 20px;
  }
  .playing .wave-bar:nth-child(4) {
    animation-delay: 0.5s;
    height: 14px;
  }

  /* 暫停或未播放時的靜態高度 */
  .music-toggle-btn:not(.playing) .wave-bar {
    height: 4px;
    background-color: var(--color-ink-light);
  }

  @keyframes bounce {
    0% {
      transform: scaleY(0.3);
    }
    100% {
      transform: scaleY(1.1);
    }
  }

  /* 行動端優化：稍微縮小尺寸，直接隱藏跑馬燈，縮小成正在播放圖示 */
  @media (max-width: 768px) {
    .audio-player-container {
      bottom: 1.5rem;
      right: 1.5rem;
    }
    .music-toggle-btn, .sfx-toggle-btn-global, .motion-toggle-btn-global {
      width: 40px;
      height: 40px;
      font-size: 0.9rem !important;
    }
    .player-tooltip {
      display: none; /* 行動端隱藏提示字 */
    }
    .music-marquee-container {
      display: none !important; /* 行動端直接隱藏跑馬燈 */
    }
  }

  /* 動畫控制圓章按鈕 */
  .motion-toggle-btn-global {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(253, 252, 247, 0.85);
    border: 1.5px solid var(--color-ink-black);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    transition: var(--transition-smooth);
    font-size: 1.05rem;
    font-family: var(--font-serif);
    font-weight: bold;
    color: var(--color-ink-black);
  }

  .motion-toggle-btn-global:hover {
    background: var(--color-paper-light);
    border-color: var(--color-mountain-cyan);
    transform: scale(1.05);
    color: var(--color-mountain-cyan);
  }

  /* 關閉狀態的動畫按鈕，呈灰墨色，顯示「靜」 */
  .motion-toggle-btn-global.disabled {
    border-color: rgba(180, 50, 50, 0.3);
    color: rgba(180, 50, 50, 0.7) !important;
    background: rgba(240, 240, 240, 0.65);
    box-shadow: none;
  }
  .motion-toggle-btn-global.disabled:hover {
    border-color: rgba(180, 50, 50, 0.6);
    color: rgba(180, 50, 50, 0.95) !important;
  }

  /* 全站常駐底欄試聽播放列 (Dock Player) - 宣紙底色、水墨青綠、古雅陰影 */
  .music-dock-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(253, 252, 247, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1.5px solid var(--color-ink-black);
    box-shadow: 0 -4px 25px rgba(0, 0, 0, 0.08);
    transform: translateY(105%);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    z-index: 1000;
    padding: 0.6rem 1.5rem;
  }

  .music-dock-bar.active {
    transform: translateY(0);
  }

  .dock-inner {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .dock-info {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 1;
    min-width: 0;
  }

  .dock-badge {
    background: var(--color-mountain-cyan);
    color: #fff;
    font-family: var(--font-serif);
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  .dock-text-group {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .dock-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .dock-song-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-ink-black);
  }

  .dock-origin-source {
    font-family: var(--font-serif);
    font-size: 0.82rem;
    color: var(--color-ink-grey);
  }

  .dock-progress-wrapper {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .dock-progress-bar {
    flex: 1;
    height: 5px;
    background: rgba(0, 0, 0, 0.08);
    border-radius: 3px;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .dock-progress-fill {
    width: 0%;
    height: 100%;
    background: var(--color-mountain-cyan);
    border-radius: 3px;
    transition: width 0.1s linear;
  }

  .dock-time-text {
    font-family: var(--font-serif);
    font-size: 0.75rem;
    color: var(--color-ink-grey);
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  .dock-actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-shrink: 0;
  }

  .dock-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #fff;
    border: 1px solid var(--color-border);
    cursor: pointer;
    transition: var(--transition-fast);
    color: var(--color-ink-black);
  }

  .dock-btn.play-pause-btn {
    width: 38px;
    height: 38px;
    border-color: var(--color-mountain-cyan);
    background: var(--color-paper-light);
    color: var(--color-mountain-cyan);
    font-size: 0.95rem;
  }

  .dock-btn.play-pause-btn:hover {
    background: var(--color-mountain-cyan);
    color: #fff;
    transform: scale(1.06);
  }

  .dock-btn.close-btn {
    width: 32px;
    height: 32px;
    font-size: 0.85rem;
    color: var(--color-ink-grey);
  }

  .dock-btn.close-btn:hover {
    color: var(--color-ink-black);
    border-color: var(--color-ink-black);
  }

  @media (max-width: 768px) {
    .music-dock-bar {
      padding: 0.6rem 1rem;
    }
    .dock-origin-source {
      display: none;
    }
    .dock-inner {
      gap: 0.8rem;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  function initAudioPlayer() {
    const audio = document.getElementById('main-bgm') as HTMLAudioElement;
    const musicBtn = document.getElementById('music-toggle');
    const sfxBtn = document.getElementById('sfx-toggle-global');
    const sfxIcon = document.getElementById('sfx-status-icon');
    const motionBtn = document.getElementById('motion-toggle-global');
    const motionText = document.getElementById('motion-status-text');
    const tooltip = document.getElementById('player-tooltip');
    
    // 跑馬燈 DOM 節點
    const marqueeContainer = document.getElementById('music-marquee-container');
    const marqueeContent = document.getElementById('music-marquee-content');

    if (!audio || !musicBtn || !sfxBtn) return () => {};

    // 解析並格式化古風歌名
    const getMusicTitle = (src: string) => {
      if (!src) return '未知曲目';
      if (src.includes('traditional-oriental-cherry-blossoms')) {
        return '《櫻花落》- 古風雅樂';
      }
      if (src.includes('bgm.mp3')) {
        return '《唐門雅樂》- 自訂背景音樂';
      }
      try {
        const url = new URL(src, window.location.href);
        const filename = url.pathname.substring(url.pathname.lastIndexOf('/') + 1);
        const nameWithoutExt = filename.replace(/\.[^/.]+$/, "");
        return `《${decodeURIComponent(nameWithoutExt)}》`;
      } catch (e) {
        return '《唐門雅樂》';
      }
    };

    let isToggling = false;

    // 同步背景音樂按鈕的 UI 狀態與跑馬燈狀態（僅由 play/pause 事件驅動）
    let needScroll = false;

    // 同步背景音樂按鈕的 UI 狀態與跑馬燈狀態（僅由 play/pause 事件驅動）
    const updateMusicUI = () => {
      if (audio.paused) {
        musicBtn.classList.remove('playing');
        if (marqueeContainer) {
          marqueeContainer.classList.remove('visible');
          marqueeContainer.classList.remove('should-scroll');
        }
        needScroll = false;
      } else {
        musicBtn.classList.add('playing');
        if (marqueeContainer && marqueeContent) {
          const title = getMusicTitle(audio.src);
          // 先放置單份文字以測量實際寬度
          marqueeContent.textContent = title;
          marqueeContainer.classList.add('visible');
          
          // 重置滾動狀態
          marqueeContainer.classList.remove('should-scroll');
          needScroll = false;
          
          // 延遲測量以防 DOM 未完全展開，當歌名長度超出 130px 時啟用雙生無縫跑馬燈滾動
          setTimeout(() => {
            if (!audio.paused) {
              const singleWidth = marqueeContent.scrollWidth;
              if (singleWidth > 130) {
                needScroll = true;
                marqueeContent.innerHTML = `<span>${title}</span><span style="display:inline-block; width: 3.5rem;"></span><span>${title}</span>`;
                marqueeContainer.classList.add('should-scroll');
              } else {
                needScroll = false;
                marqueeContent.textContent = title;
              }
            }
          }, 80);
        }
      }
    };

    // 瀏覽器標籤頁隱藏時暫停動畫，節能省電
    const handleVisibilityChange = () => {
      if (!marqueeContainer || !marqueeContent) return;
      if (document.hidden) {
        marqueeContainer.classList.remove('should-scroll');
      } else if (!audio.paused && needScroll) {
        marqueeContainer.classList.add('should-scroll');
      }
    };
    // 引入 Busy Lock 避免快速點擊產生的狀態衝突
    const toggleMusic = () => {
      if (isToggling) return;
      isToggling = true;

      if (audio.paused) {
        audio.play()
          .catch((err) => {
            console.log('音樂播放失敗，可能需要更多使用者互動：', err);
          })
          .finally(() => {
            setTimeout(() => { isToggling = false; }, 200);
          });
      } else {
        audio.pause();
        setTimeout(() => { isToggling = false; }, 200);
      }
    };

    musicBtn.addEventListener('click', toggleMusic);
    audio.addEventListener('play', updateMusicUI);
    audio.addEventListener('pause', updateMusicUI);
    document.addEventListener('visibilitychange', handleVisibilityChange);


    // 2. 同步全域按鍵音效的 UI 狀態
    const updateSfxUI = () => {
      const isEnabled = localStorage.getItem('shanzhuang_sfx_click_enabled') !== 'false';
      if (isEnabled) {
        sfxBtn.classList.remove('muted');
        if (sfxIcon) sfxIcon.textContent = '🔔';
      } else {
        sfxBtn.classList.add('muted');
        if (sfxIcon) sfxIcon.textContent = '🔕';
      }
    };

    const toggleSfx = () => {
      const isEnabled = localStorage.getItem('shanzhuang_sfx_click_enabled') !== 'false';
      localStorage.setItem('shanzhuang_sfx_click_enabled', isEnabled ? 'false' : 'true');
      updateSfxUI();
    };

    sfxBtn.addEventListener('click', toggleSfx);

    // 3. 動態更新 Tooltip 提示內容
    const handleMusicTooltip = () => {
      if (tooltip) tooltip.textContent = audio.paused ? '開啟背景音樂' : '關閉背景音樂';
    };
    const handleSfxTooltip = () => {
      const isEnabled = localStorage.getItem('shanzhuang_sfx_click_enabled') !== 'false';
      if (tooltip) tooltip.textContent = isEnabled ? '關閉按鍵音效' : '開啟按鍵音效';
    };

    musicBtn.addEventListener('mouseenter', handleMusicTooltip);
    sfxBtn.addEventListener('mouseenter', handleSfxTooltip);

    // 4. 同步全域動畫的 UI 與 GSAP 狀態
    const updateMotionUI = () => {
      if (!motionBtn || !motionText) return;
      const isEnabled = localStorage.getItem('global_motion_enabled') !== 'false';
      if (isEnabled) {
        motionBtn.classList.remove('disabled');
        motionText.textContent = '動';
        document.body.classList.remove("no-motion");
        gsap.globalTimeline.timeScale(1);
      } else {
        motionBtn.classList.add('disabled');
        motionText.textContent = '靜';
        document.body.classList.add("no-motion");
        gsap.globalTimeline.timeScale(9999);
      }
    };

    const toggleMotion = () => {
      const isEnabled = localStorage.getItem('global_motion_enabled') !== 'false';
      localStorage.setItem('global_motion_enabled', isEnabled ? 'false' : 'true');
      updateMotionUI();
    };

    const handleMotionTooltip = () => {
      const isEnabled = localStorage.getItem('global_motion_enabled') !== 'false';
      if (tooltip) tooltip.textContent = isEnabled ? '關閉全站動效' : '開啟全站動效';
    };

    if (motionBtn) {
      motionBtn.addEventListener('click', toggleMotion);
      motionBtn.addEventListener('mouseenter', handleMotionTooltip);
    }

    // 5. 作品集音樂試聽常駐底欄播放器邏輯 (Preview Audio & Dock Player)
    const previewAudio = document.getElementById('preview-audio') as HTMLAudioElement;
    const dockBar = document.getElementById('music-dock-bar');
    const dockTitle = document.getElementById('dock-song-title');
    const dockOrigin = document.getElementById('dock-origin-source');
    const dockPlayPauseBtn = document.getElementById('dock-play-pause-btn');
    const dockPlayIcon = document.getElementById('dock-play-icon');
    const dockCloseBtn = document.getElementById('dock-close-btn');
    const dockProgressFill = document.getElementById('dock-progress-fill');
    const dockProgressBar = document.getElementById('dock-progress-bar');
    const dockTimeText = document.getElementById('dock-time-text');

    const formatTime = (seconds: number) => {
      if (isNaN(seconds) || !isFinite(seconds)) return '00:00';
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    };

    const updateDockTime = () => {
      if (!previewAudio || !dockProgressFill || !dockTimeText) return;
      const cur = previewAudio.currentTime || 0;
      const dur = previewAudio.duration || 0;
      const percent = dur > 0 ? (cur / dur) * 100 : 0;
      dockProgressFill.style.width = `${percent}%`;
      dockTimeText.textContent = `${formatTime(cur)} / ${formatTime(dur)}`;
    };

    const updateDockUI = () => {
      if (!previewAudio || !dockPlayIcon) return;
      if (previewAudio.paused) {
        dockPlayIcon.textContent = '▶';
      } else {
        dockPlayIcon.textContent = '⏸';
      }
    };

    // 播放指定作品試聽曲目（若背景音樂正在播放，自動暫停背景音樂，避免雜音）
    const playSongPreview = (audioUrl: string, title: string, original?: string) => {
      if (!previewAudio || !dockBar) return;
      
      // 暫停全站背景音樂
      if (!audio.paused) {
        audio.pause();
      }

      if (dockTitle) dockTitle.textContent = title;
      if (dockOrigin) {
        dockOrigin.textContent = original ? `原曲：${original}` : '';
        dockOrigin.style.display = original ? 'inline' : 'none';
      }

      dockBar.classList.add('active');

      // 若為同一首曲子且已暫停，直接恢復播放
      const targetSrc = new URL(audioUrl, window.location.href).href;
      if (previewAudio.src === targetSrc && previewAudio.paused) {
        previewAudio.play().catch(console.error);
        return;
      }

      previewAudio.src = audioUrl;
      previewAudio.load();
      previewAudio.play().catch(console.error);
    };

    const toggleDockPlay = () => {
      if (!previewAudio) return;
      if (previewAudio.paused) {
        // 若背景音樂在播放，先關閉
        if (!audio.paused) audio.pause();
        previewAudio.play().catch(console.error);
      } else {
        previewAudio.pause();
      }
    };

    const closeDock = () => {
      if (!previewAudio || !dockBar) return;
      previewAudio.pause();
      previewAudio.currentTime = 0;
      dockBar.classList.remove('active');
    };

    const handleProgressClick = (e: MouseEvent) => {
      if (!previewAudio || !dockProgressBar) return;
      const rect = dockProgressBar.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const width = rect.width;
      if (width > 0 && previewAudio.duration > 0) {
        const ratio = Math.max(0, Math.min(1, clickX / width));
        previewAudio.currentTime = ratio * previewAudio.duration;
      }
    };

    if (dockPlayPauseBtn) dockPlayPauseBtn.addEventListener('click', toggleDockPlay);
    if (dockCloseBtn) dockCloseBtn.addEventListener('click', closeDock);
    if (dockProgressBar) dockProgressBar.addEventListener('click', handleProgressClick);

    if (previewAudio) {
      previewAudio.addEventListener('timeupdate', updateDockTime);
      previewAudio.addEventListener('play', updateDockUI);
      previewAudio.addEventListener('pause', updateDockUI);
      previewAudio.addEventListener('ended', () => {
        updateDockUI();
        if (dockProgressFill) dockProgressFill.style.width = '0%';
      });
    }

    // 註冊全域事件供作品卡片觸發試聽
    (window as any).__playSiteMusic = playSongPreview;

    // 初始狀態同步
    updateMusicUI();
    updateSfxUI();
    updateMotionUI();

    return () => {
      musicBtn.removeEventListener('click', toggleMusic);
      audio.removeEventListener('play', updateMusicUI);
      audio.removeEventListener('pause', updateMusicUI);
      document.removeEventListener('visibilitychange', handleVisibilityChange);
      sfxBtn.removeEventListener('click', toggleSfx);
      musicBtn.removeEventListener('mouseenter', handleMusicTooltip);
      sfxBtn.removeEventListener('mouseenter', handleSfxTooltip);
      if (motionBtn) {
        motionBtn.removeEventListener('click', toggleMotion);
        motionBtn.removeEventListener('mouseenter', handleMotionTooltip);
      }
      if (dockPlayPauseBtn) dockPlayPauseBtn.removeEventListener('click', toggleDockPlay);
      if (dockCloseBtn) dockCloseBtn.removeEventListener('click', closeDock);
      if (dockProgressBar) dockProgressBar.removeEventListener('click', handleProgressClick);
      if (previewAudio) {
        previewAudio.removeEventListener('timeupdate', updateDockTime);
        previewAudio.removeEventListener('play', updateDockUI);
        previewAudio.removeEventListener('pause', updateDockUI);
      }
    };
  }

  let cleanupAudio: (() => void) | null = null;

  // 配合 Astro ViewTransitions
  document.addEventListener('astro:page-load', () => {
    // 每次 Astro 載入新頁面時，持久化的 audio 依然存在，
    // 但新頁面的 button 需要重新綁定事件。
    if (cleanupAudio) cleanupAudio();
    cleanupAudio = initAudioPlayer();
  });

  document.addEventListener('astro:before-preparation', () => {
    if (cleanupAudio) {
      cleanupAudio();
      cleanupAudio = null;
    }
  });
</script>
