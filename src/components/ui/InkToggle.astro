---
interface Props {
  id?: string;
  name?: string;
  checked?: boolean;
  label?: string;
  ariaLabel?: string;
  class?: string;
  size?: 'sm' | 'md' | 'lg';
}

const {
  id,
  name,
  checked = false,
  label,
  ariaLabel,
  class: className = '',
  size = 'md',
  ...rest
} = Astro.props;

const toggleId = id || `ink-toggle-${Math.random().toString(36).substring(2, 9)}`;
---

<label
  for={toggleId}
  class={`ink-toggle-wrapper ink-toggle-${size} ${className}`}
  title={ariaLabel || label}
>
  <input
    type="checkbox"
    id={toggleId}
    name={name}
    checked={checked}
    class="ink-toggle-checkbox"
    aria-label={ariaLabel || label}
    {...rest}
  />
  <span class="ink-toggle-track">
    <span class="ink-toggle-thumb">
      <span class="taiji-dot taiji-dot-left"></span>
      <span class="taiji-dot taiji-dot-right"></span>
    </span>
  </span>
  {label && <span class="ink-toggle-label">{label}</span>}
</label>

<style>
  .ink-toggle-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    font-family: var(--font-cursive, serif);
  }

  .ink-toggle-checkbox {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  /* 軌道槽：水墨宣紙微凹槽 */
  .ink-toggle-track {
    position: relative;
    display: inline-block;
    width: 48px;
    height: 26px;
    background: var(--color-paper-light, #fdfcf7);
    border: 1px solid var(--color-border, #e6dfcc);
    border-radius: 9999px;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.04);
    transition: background-color 0.3s cubic-bezier(0.25, 0.8, 0.25, 1),
                border-color 0.3s ease,
                box-shadow 0.3s ease;
  }

  /* 太極滑塊 */
  .ink-toggle-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-ink-black, #1a1a1a);
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.15);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
                background-color 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* 太極雙魚眼微動態 */
  .taiji-dot {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .taiji-dot-left {
    background: var(--color-paper-light, #fdfcf7);
    transform: translateY(-3px);
  }
  .taiji-dot-right {
    background: var(--color-mountain-cyan, #2d5f5a);
    transform: translateY(3px);
  }

  /* 開啟狀態 (Checked) */
  .ink-toggle-checkbox:checked + .ink-toggle-track {
    background: rgba(45, 95, 90, 0.12);
    border-color: var(--color-mountain-cyan, #2d5f5a);
    box-shadow: inset 0 2px 4px rgba(45, 95, 90, 0.08), 0 0 10px rgba(45, 95, 90, 0.15);
  }

  .ink-toggle-checkbox:checked + .ink-toggle-track .ink-toggle-thumb {
    transform: translateX(22px) rotate(180deg);
    background: var(--color-mountain-cyan, #2d5f5a);
  }

  /* 鍵盤焦點無障礙 */
  .ink-toggle-checkbox:focus-visible + .ink-toggle-track {
    outline: 2px solid var(--color-mountain-cyan, #2d5f5a);
    outline-offset: 2px;
  }

  /* 尺寸規範 */
  .ink-toggle-sm .ink-toggle-track {
    width: 38px;
    height: 20px;
  }
  .ink-toggle-sm .ink-toggle-thumb {
    width: 14px;
    height: 14px;
    top: 2px;
    left: 2px;
  }
  .ink-toggle-sm .ink-toggle-checkbox:checked + .ink-toggle-track .ink-toggle-thumb {
    transform: translateX(18px) rotate(180deg);
  }

  .ink-toggle-lg .ink-toggle-track {
    width: 58px;
    height: 32px;
  }
  .ink-toggle-lg .ink-toggle-thumb {
    width: 26px;
    height: 26px;
  }
  .ink-toggle-lg .ink-toggle-checkbox:checked + .ink-toggle-track .ink-toggle-thumb {
    transform: translateX(26px) rotate(180deg);
  }

  .ink-toggle-label {
    font-size: 0.95rem;
    color: var(--color-ink-text, #2c2c2c);
  }

  @media (prefers-reduced-motion: reduce) {
    .ink-toggle-track,
    .ink-toggle-thumb,
    .taiji-dot {
      transition: none !important;
    }
  }
</style>
