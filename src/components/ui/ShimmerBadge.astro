---
interface Props {
  icon?: string;
  variant?: 'default' | 'cyan' | 'accent';
  interactive?: boolean;
  class?: string;
  title?: string;
}

const {
  icon,
  variant = 'default',
  interactive = true,
  class: className = '',
  title,
  ...rest
} = Astro.props;
---

<div
  class={`shimmer-badge shimmer-${variant} ${interactive ? 'is-interactive' : ''} ${className}`}
  title={title}
  {...rest}
>
  <span class="shimmer-streamer" aria-hidden="true"></span>
  <div class="shimmer-content">
    {icon && <span class="badge-icon">{icon}</span>}
    <slot name="icon" />
    <span class="badge-label">
      <slot />
    </span>
  </div>
</div>

<style>
  .shimmer-badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.95rem;
    font-family: var(--font-cursive, serif);
    letter-spacing: 0.05em;
    background: var(--color-paper-light, #fdfcf7);
    border: 1px solid var(--color-border, #e6dfcc);
    color: var(--color-ink-text, #2c2c2c);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.02);
    overflow: hidden;
    transition: transform 0.25s cubic-bezier(0.25, 0.8, 0.25, 1),
                border-color 0.25s ease,
                box-shadow 0.25s ease;
  }

  .shimmer-content {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .badge-icon {
    font-size: 1rem;
    line-height: 1;
  }

  .badge-label {
    line-height: 1.4;
  }

  /* 水墨微光流動線條 (Galaxy Shimmer 概念) */
  .shimmer-streamer {
    position: absolute;
    top: 0;
    left: -150%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(45, 95, 90, 0.08) 50%,
      transparent 100%
    );
    transform: skewX(-20deg);
    pointer-events: none;
    z-index: 1;
    transition: left 0.6s ease;
  }

  /* 互動態 */
  .shimmer-badge.is-interactive:hover {
    transform: translateY(-2px);
    border-color: var(--color-mountain-cyan, #2d5f5a);
    box-shadow: 0 3px 8px rgba(45, 95, 90, 0.08);
  }

  .shimmer-badge.is-interactive:hover .shimmer-streamer {
    left: 150%;
  }

  /* 變體：Cyan 石青風格 */
  .shimmer-cyan {
    border-color: rgba(45, 95, 90, 0.3);
    color: var(--color-mountain-cyan, #2d5f5a);
  }

  /* 變體：Accent 赭石點綴風格 */
  .shimmer-accent {
    border-color: rgba(196, 140, 59, 0.3);
    color: var(--color-mountain-accent, #c48c3b);
  }

  @media (prefers-reduced-motion: reduce) {
    .shimmer-badge,
    .shimmer-streamer {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
