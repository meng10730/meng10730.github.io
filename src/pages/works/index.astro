---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import InkCard from "../../components/ui/InkCard.astro";
import PulseBadge from "../../components/ui/PulseBadge.astro";
import InkButton from "../../components/ui/InkButton.astro";
import ShimmerBadge from "../../components/ui/ShimmerBadge.astro";

const allWorks = await getCollection("works", (entry) => {
  return !entry.id.startsWith("_");
});

// 按分類篩選
const webWorks = allWorks.filter((work) => work.data.category === "web");
const gameWorks = allWorks.filter((work) => work.data.category === "game");
const musicWorks = allWorks.filter((work) => work.data.category === "music");
const otherWorks = allWorks.filter((work) => work.data.category === "other");

const categories = [
  { id: "web", name: "網頁開發", works: webWorks },
  { id: "game", name: "遊戲作品", works: gameWorks },
  { id: "music", name: "音樂創作與改編", works: musicWorks },
  { id: "other", name: "其他創作", works: otherWorks },
];

const statusMap = {
  completed: "已完成",
  ongoing: "進行中",
  archived: "封存中",
};
---

<Layout title="作品集 | 晚餐後的書桌" description="吃墨水的晚餐之專案作品集，包含網頁開發、遊戲作品、音樂創作與改編及其他創作。">
  <div class="works-container ink-fade-in">
    <h1 class="page-title">作品集</h1>
    <div class="mountain-line"></div>

    <div class="categories-wrapper">
      {
        categories.map(({ id, name, works }) => (
          <section class="category-section" id={id}>
            <h2 class="category-title cursive-title">{name}</h2>

            {works.length === 0 ? (
              <div class="empty-state paper-card">
                <p>此類專案目前正由晚餐潛心研發中，暫無公開展示，敬請期待...</p>
              </div>
            ) : (
              <div class="works-grid">
                {works.map((work) => (
                  <InkCard class="work-card">
                    <div>
                      <div class="card-header">
                        <PulseBadge status={work.data.status} />
                        <span class="pub-date">
                          {new Date(work.data.pubDate).toLocaleDateString(
                            "zh-TW",
                            {
                              year: "numeric",
                              month: "long",
                            },
                          )}
                        </span>
                      </div>

                      <!-- 原曲出處標籤 (音樂專屬) -->
                      {work.data.originalSource && (
                        <div class="original-source-pill">
                          <span class="source-prefix">改編自：</span>
                          <span class="source-text">{work.data.originalSource}</span>
                        </div>
                      )}

                      <h3 class="work-title">{work.data.title}</h3>
                      <p class="work-desc">{work.data.description}</p>

                      {work.data.techs && work.data.techs.length > 0 && (
                        <div class="tech-tags">
                          {work.data.techs.map((tech) => (
                            <ShimmerBadge 
                              class="tech-shimmer-tag" 
                              interactive={false} 
                              variant={work.data.category === 'music' ? 'cyan' : 'default'}
                            >
                              {tech}
                            </ShimmerBadge>
                          ))}
                        </div>
                      )}
                    </div>

                    <!-- 操作按鈕區 -->
                    <div class="card-links">
                      {work.data.category === "music" ? (
                        <>
                          {work.data.audio && (
                            <button
                              class="ink-button-preview play-music-btn"
                              data-audio={work.data.audio}
                              data-title={work.data.title}
                              data-original={work.data.originalSource || ""}
                            >
                              ▶ 試聽曲目
                            </button>
                          )}
                          {work.data.originalUrl && (
                            <InkButton
                              href={work.data.originalUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              variant="secondary"
                              size="sm"
                            >
                              原曲出處 ↗
                            </InkButton>
                          )}
                          {work.data.sheetUrl && (
                            <InkButton
                              href={work.data.sheetUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              variant="primary"
                              size="sm"
                            >
                              樂譜下載 ↗
                            </InkButton>
                          )}
                        </>
                      ) : (
                        <>
                          {work.data.github && (
                            <InkButton
                              href={work.data.github}
                              target="_blank"
                              rel="noopener noreferrer"
                              variant="secondary"
                              size="sm"
                            >
                              原始碼
                            </InkButton>
                          )}
                          {work.data.demo && (
                            <InkButton
                              href={work.data.demo}
                              target="_blank"
                              rel="noopener noreferrer"
                              variant="primary"
                              size="sm"
                            >
                              線上預覽
                            </InkButton>
                          )}
                        </>
                      )}
                    </div>
                  </InkCard>
                ))}
              </div>
            )}
          </section>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .works-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .page-title {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .categories-wrapper {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    margin-top: 2rem;
  }

  .category-section {
    scroll-margin-top: 100px;
  }

  .category-title {
    font-size: 1.8rem;
    color: var(--color-mountain-cyan);
    margin-bottom: 1.5rem;
    border-left: 4px solid var(--color-mountain-green);
    padding-left: 0.8rem;
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .work-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    font-size: 0.8rem;
  }

  .status-badge {
    padding: 0.2rem 0.6rem;
    border-radius: 99px;
    font-weight: 600;
  }

  .status-badge.completed {
    background: rgba(61, 126, 90, 0.1);
    color: var(--color-mountain-green);
    border: 1px solid rgba(61, 126, 90, 0.2);
  }

  .status-badge.ongoing {
    background: rgba(196, 140, 59, 0.1);
    color: var(--color-mountain-accent);
    border: 1px solid rgba(196, 140, 59, 0.2);
  }

  .status-badge.archived {
    background: rgba(92, 92, 92, 0.1);
    color: var(--color-ink-grey);
    border: 1px solid rgba(92, 92, 92, 0.2);
  }

  .pub-date {
    color: var(--color-ink-grey);
  }

  .work-title {
    font-size: 1.25rem;
    margin-bottom: 0.8rem;
    color: var(--color-ink-black);
  }

  .work-desc {
    font-size: 0.95rem;
    color: var(--color-ink-text);
    line-height: 1.6;
    margin-bottom: 1.2rem;
    flex-grow: 1;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .tech-tag {
    font-size: 0.75rem;
    background: rgba(0, 0, 0, 0.03);
    color: var(--color-ink-grey);
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
    border: 1px solid rgba(0, 0, 0, 0.05);
  }

  .card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    border-top: 1px dashed var(--color-border);
    padding-top: 1rem;
  }

  .card-links :global(.ink-btn) {
    flex: 1 1 110px;
    text-align: center;
    min-width: 100px;
  }

  .link-btn {
    flex: 1;
    text-align: center;
    font-size: 0.9rem;
    padding: 0.4rem 0;
    border-radius: 4px;
    border: 1px solid var(--color-mountain-cyan);
    transition: var(--transition-fast);
  }

  .link-btn.github {
    background: transparent;
    color: var(--color-mountain-cyan);
  }

  .link-btn.github:hover {
    background: rgba(45, 95, 90, 0.05);
  }

  .link-btn.demo {
    background: var(--color-mountain-cyan);
    color: var(--color-paper-light);
  }

  .link-btn.demo:hover {
    background: var(--color-mountain-green);
    border-color: var(--color-mountain-green);
  }

  .empty-state {
    text-align: center;
    padding: 3rem 2rem;
    color: var(--color-ink-grey);
    font-style: italic;
  }

  /* 原曲出處標籤 (音樂專屬) */
  .original-source-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-bottom: 0.6rem;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    background: rgba(45, 95, 90, 0.08);
    border: 1px solid rgba(45, 95, 90, 0.18);
    font-family: var(--font-serif);
    font-size: 0.82rem;
    color: var(--color-mountain-cyan);
  }

  .source-prefix {
    font-weight: 600;
    opacity: 0.85;
  }

  .source-text {
    font-weight: 500;
  }

  /* 試聽曲目專屬按鈕 (水墨青綠) */
  .ink-button-preview {
    flex: 1 1 110px;
    min-width: 100px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.45rem 0.8rem;
    border-radius: 4px;
    font-family: var(--font-serif);
    font-size: 0.88rem;
    font-weight: 600;
    background: var(--color-mountain-cyan);
    color: #fff;
    border: 1px solid var(--color-mountain-cyan);
    cursor: pointer;
    transition: var(--transition-fast);
    box-shadow: 0 2px 6px rgba(45, 95, 90, 0.2);
  }

  .ink-button-preview:hover {
    background: var(--color-mountain-green);
    border-color: var(--color-mountain-green);
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(45, 95, 90, 0.3);
  }
</style>

<script>
  function setupMusicPlayButtons() {
    const playBtns = document.querySelectorAll('.play-music-btn');
    playBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const target = e.currentTarget as HTMLElement;
        const audioUrl = target.getAttribute('data-audio');
        const title = target.getAttribute('data-title') || '曲目試聽';
        const original = target.getAttribute('data-original') || '';

        if (audioUrl && (window as any).__playSiteMusic) {
          (window as any).__playSiteMusic(audioUrl, title, original);
        } else if (audioUrl) {
          // 降級處理
          const audio = new Audio(audioUrl);
          audio.play().catch(console.error);
        }
      });
    });
  }

  document.addEventListener('astro:page-load', setupMusicPlayButtons);
</script>
