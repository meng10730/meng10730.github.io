<script>
  function initNovelReader() {
    const wrapper = document.getElementById('reader-wrapper');
    if (!wrapper) return;

    const bookSlug = wrapper.getAttribute('data-book');
    const initialSlug = wrapper.getAttribute('data-current-slug');
    const baseUrl = document.querySelector('meta[name="base-url"]')?.getAttribute('content') || '/';

    // 1. 左側目錄抽屜開關 (支援點擊與懸停)
    const tocDrawer = document.getElementById('toc-drawer');
    const tocOverlay = document.getElementById('toc-drawer-overlay');
    const leftTocTrigger = document.getElementById('left-toc-trigger');
    const closeTocBtn = document.getElementById('toc-drawer-close');

    function openDrawer() {
      if (tocDrawer) tocDrawer.classList.add('open');
      if (tocOverlay) tocOverlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeDrawer() {
      if (tocDrawer) tocDrawer.classList.remove('open');
      if (tocOverlay) tocOverlay.classList.remove('open');
      document.body.style.overflow = '';
    }

    if (leftTocTrigger) {
      leftTocTrigger.addEventListener('click', openDrawer);
    }
    if (closeTocBtn) closeTocBtn.addEventListener('click', closeDrawer);
    if (tocOverlay) tocOverlay.addEventListener('click', closeDrawer);

    // 2. 主題切換持久化
    const themeButtons = document.querySelectorAll('.theme-btn');
    const savedTheme = localStorage.getItem('novel_reader_theme') || 'rice-paper';
    applyTheme(savedTheme);

    themeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const theme = btn.getAttribute('data-theme');
        if (theme) {
          applyTheme(theme);
          localStorage.setItem('novel_reader_theme', theme);
        }
      });
    });

    function applyTheme(theme: string) {
      document.body.classList.remove('theme-dark', 'theme-rice-paper', 'theme-eyecare', 'theme-light');
      document.body.classList.add(`theme-${theme}`);
      themeButtons.forEach(b => {
        b.classList.toggle('active', b.getAttribute('data-theme') === theme);
      });
    }

    // 4. 字體縮放持久化
    const fontDecrease = document.getElementById('font-decrease');
    const fontIncrease = document.getElementById('font-increase');
    let currentFontSize = parseFloat(localStorage.getItem('novel_reader_fontsize') || '1.15');

    function applyFontSize(size: number) {
      const bodies = document.querySelectorAll<HTMLElement>('.novel-body');
      bodies.forEach(b => b.style.fontSize = `${size}rem`);
      localStorage.setItem('novel_reader_fontsize', size.toString());
    }
    applyFontSize(currentFontSize);

    if (fontDecrease) {
      fontDecrease.addEventListener('click', () => {
        if (currentFontSize > 0.9) {
          currentFontSize -= 0.1;
          applyFontSize(currentFontSize);
        }
      });
    }
    if (fontIncrease) {
      fontIncrease.addEventListener('click', () => {
        if (currentFontSize < 1.6) {
          currentFontSize += 0.1;
          applyFontSize(currentFontSize);
        }
      });
    }

    // 5. 滾動進度條
    const progressBar = document.getElementById('reading-progress-bar');
    window.addEventListener('scroll', () => {
      const currentScrollY = window.scrollY || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      if (height > 0 && progressBar) {
        const scrolled = (currentScrollY / height) * 100;
        progressBar.style.width = `${scrolled}%`;
      }
    });

    // 5. 鍵盤翻頁快捷鍵 (← 上一節, → 下一節)
    const prevLink = document.getElementById('nav-prev-link') as HTMLAnchorElement | null;
    const nextLink = document.getElementById('nav-next-link') as HTMLAnchorElement | null;

    document.addEventListener('keydown', (e) => {
      const activeTag = (document.activeElement?.tagName || '').toLowerCase();
      if (['input', 'textarea', 'select'].includes(activeTag)) return;

      if (e.key === 'ArrowLeft' && prevLink) {
        prevLink.click();
      } else if (e.key === 'ArrowRight' && nextLink) {
        nextLink.click();
      }
    });

    // 6. 專有名詞識別觸發 (對當前章的所有小節進行掃描)
    document.querySelectorAll('.chapter-article').forEach(article => {
      if ((window as any).refreshGlossaryTerms) {
        (window as any).refreshGlossaryTerms(article);
      }
    });

    // 7. 初始小節定位 (若讀者點擊了特定小節進入)
    if (initialSlug) {
      const targetSecEl = document.getElementById(`section-${initialSlug}`);
      if (targetSecEl && targetSecEl !== document.querySelector('.chapter-article')) {
        targetSecEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // 8. 側邊目錄目前小節 Active 狀態監聽與進度記錄
    const sectionObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const activeSlug = entry.target.getAttribute('data-slug');
          const activeTitle = entry.target.getAttribute('data-title') || '';
          if (activeSlug) {
            document.querySelectorAll('.toc-section-link').forEach(link => {
              const isActive = link.getAttribute('data-slug') === activeSlug;
              link.classList.toggle('active', isActive);
              if (isActive) {
                const detailsParent = link.closest('details');
                if (detailsParent) detailsParent.open = true;
              }
            });

            // 記錄至 LocalStorage
            if (bookSlug) {
              localStorage.setItem(`novel_progress_${bookSlug}`, JSON.stringify({
                slug: activeSlug,
                title: activeTitle,
                timestamp: Date.now()
              }));
            }
          }
        }
      });
    }, { threshold: 0.2 });

    document.querySelectorAll('.chapter-article').forEach(article => {
      sectionObserver.observe(article);
    });
  }

  document.addEventListener('astro:page-load', initNovelReader);
</script>
