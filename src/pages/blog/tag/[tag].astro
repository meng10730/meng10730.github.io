---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import ShimmerBadge from '../../../components/ui/ShimmerBadge.astro';
import { getCategoryInfo, getArticleExcerpt } from '../../../utils/blogCategories';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  
  // 收集全站所有出現過的標籤
  const tagMap = new Map<string, typeof allPosts>();
  allPosts.forEach((post) => {
    if (post.data.tags && Array.isArray(post.data.tags)) {
      post.data.tags.forEach((rawTag: string) => {
        const tag = rawTag.trim();
        if (!tag) return;
        if (!tagMap.has(tag)) {
          tagMap.set(tag, []);
        }
        tagMap.get(tag)!.push(post);
      });
    }
  });

  return Array.from(tagMap.entries()).map(([tag, posts]) => {
    const sortedPosts = posts.sort(
      (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
    );
    return {
      params: { tag },
      props: {
        currentTag: tag,
        posts: sortedPosts,
        totalPostCount: allPosts.length,
      },
    };
  });
}

const { currentTag, posts } = Astro.props;

// 格式化日期
const formatDate = (date: Date) => {
  return date.toLocaleDateString('zh-Hant', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

const breadcrumbs = [
  { name: '首頁', url: '/' },
  { name: '觀其文', url: '/blog' },
  { name: `# ${currentTag}`, url: `/blog/tag/${encodeURIComponent(currentTag)}` },
];
---

<Layout
  title={`# ${currentTag} · 文章標籤 | 觀其文 · 晚餐後的書桌`}
  description={`觀其文專欄標籤「${currentTag}」相關文章索引，共收錄 ${posts.length} 篇作品。`}
  breadcrumbs={breadcrumbs}
>
  <div class="blog-tag-container">
    
    <!-- 返回導覽列 -->
    <div class="nav-top-bar ink-fade-in">
      <a href={`${import.meta.env.BASE_URL}blog/`} class="ink-link back-link">
        ← 返回觀其文文章總覽
      </a>
    </div>

    <!-- 頁面標題與標籤印章 -->
    <header class="tag-header ink-fade-in" style="animation-delay: 0.1s;">
      <div class="tag-badge-seal">
        #
      </div>

      <h1 class="cursive-title page-title">#{currentTag}</h1>
      <p class="tag-desc">
        共檢索得 <strong>{posts.length}</strong> 篇標註此標籤之墨痕文章
      </p>

      <div class="mountain-line"></div>
    </header>

    <!-- 時間軸文章列表 -->
    <div class="posts-timeline ink-fade-in" style="animation-delay: 0.2s;">
      {posts.length === 0 ? (
        <div class="paper-card no-posts">
          <span class="empty-icon">📭</span>
          <h3 class="empty-title">暫無相關文章</h3>
          <p class="empty-desc">此標籤下目前尚無登錄文章。</p>
          <a href={`${import.meta.env.BASE_URL}blog/`} class="ink-link empty-btn">
            ← 返回觀其文
          </a>
        </div>
      ) : (
        <div class="timeline-wrapper">
          <div class="timeline-line"></div>
          
          {posts.map((post, index) => {
            const catInfo = getCategoryInfo(post.data.category);
            return (
              <article class="timeline-item" style={`animation-delay: ${0.08 * index}s;`}>
                <div class="timeline-dot" style={`--dot-color: ${catInfo.color};`}></div>
                
                <div class="post-date">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                </div>

                <div class="post-card-wrapper">
                  <a href={`${import.meta.env.BASE_URL}blog/${post.slug}/`} class="post-link-card" data-astro-prefetch="hover">
                    <div class="paper-card post-card" style={`--card-cat-color: ${catInfo.color};`}>
                      
                      <!-- 分類與主題 -->
                      <div class="post-top-meta">
                        <span class="category-pill" style={`background-color: ${catInfo.color};`}>
                          {catInfo.name}
                        </span>
                        {post.data.topic && (
                          <span class="topic-label">
                            <span class="topic-dot"></span>
                            {post.data.topic}
                          </span>
                        )}
                      </div>

                      <h2 class="post-title">{post.data.title}</h2>
                      <p class="post-description">{getArticleExcerpt(post)}</p>
                      
                      <div class="post-meta">
                        <!-- 標籤列表 -->
                        {post.data.tags && post.data.tags.length > 0 && (
                          <div class="post-tags">
                            {post.data.tags.map((tag: string) => (
                              <ShimmerBadge 
                                variant={tag === currentTag ? 'cyan' : 'default'}
                                href={`${import.meta.env.BASE_URL}blog/tag/${encodeURIComponent(tag)}/`}
                              >
                                # {tag}
                              </ShimmerBadge>
                            ))}
                          </div>
                        )}
                        
                        <span class="read-more-link ink-link">閱全文 →</span>
                      </div>
                    </div>
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>

  </div>
</Layout>

<style>
  .blog-tag-container {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .nav-top-bar {
    display: flex;
    justify-content: flex-start;
  }

  .back-link {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: var(--color-ink-grey);
    transition: var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-mountain-cyan);
  }

  .tag-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .tag-badge-seal {
    width: 44px;
    height: 44px;
    border-radius: 6px;
    background-color: var(--color-mountain-cyan, #2d5f5a);
    color: #fff;
    font-family: var(--font-cursive);
    font-size: 1.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.8rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    border: 1.5px solid rgba(255, 255, 255, 0.3);
  }

  .page-title {
    font-size: 3.5rem;
    color: var(--color-ink-black);
    margin-bottom: 0.5rem;
  }

  .tag-desc {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--color-ink-grey);
    letter-spacing: 0.08em;
    max-width: 600px;
    margin-bottom: 2rem;
  }

  /* 時間軸架構 */
  .posts-timeline {
    position: relative;
    padding: 1rem 0;
  }

  .timeline-wrapper {
    position: relative;
  }

  .timeline-line {
    position: absolute;
    left: 200px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: linear-gradient(
      to bottom,
      var(--color-ink-light) 0%,
      var(--color-border) 50%,
      transparent 100%
    );
    opacity: 0.5;
  }

  .timeline-item {
    position: relative;
    display: flex;
    margin-bottom: 3rem;
    align-items: flex-start;
  }

  .timeline-dot {
    position: absolute;
    left: 197px;
    top: 12px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--dot-color, var(--color-ink-black));
    border: 2px solid var(--color-paper-bg);
    box-shadow: 0 0 8px rgba(0, 0, 0, 0.2);
    z-index: 5;
    transition: var(--transition-fast);
  }

  .timeline-item:hover .timeline-dot {
    transform: scale(1.4);
    box-shadow: 0 0 12px rgba(0, 0, 0, 0.3);
  }

  .post-date {
    width: 170px;
    text-align: right;
    padding-top: 5px;
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: var(--color-ink-grey);
    letter-spacing: 0.05em;
  }

  .post-card-wrapper {
    flex: 1;
    margin-left: 55px;
  }

  .post-link-card {
    display: block;
    text-decoration: none;
  }

  .post-card {
    padding: 1.8rem 2rem;
    border-left: 3px solid var(--card-cat-color, var(--color-border));
    transition: all 0.3s ease;
  }

  .post-card:hover {
    transform: translateX(4px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
  }

  .post-top-meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.8rem;
  }

  .category-pill {
    font-size: 0.85rem;
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    color: #fff;
    font-family: var(--font-serif);
  }

  .topic-label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-serif);
    font-size: 0.85rem;
    color: var(--color-ink-grey);
  }

  .topic-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-ink-grey);
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-ink-black);
    margin-bottom: 0.8rem;
    transition: var(--transition-fast);
  }

  .post-link-card:hover .post-title {
    color: var(--color-mountain-cyan);
  }

  .post-description {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink-text);
    margin-bottom: 1.5rem;
    text-align: justify;
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    border-top: 1px dashed rgba(230, 223, 204, 0.6);
    padding-top: 1rem;
  }

  .post-tags {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    position: relative;
    z-index: 5;
  }

  .read-more-link {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-ink-black);
  }

  .post-link-card:hover .read-more-link {
    color: var(--color-mountain-cyan);
  }

  .no-posts {
    text-align: center;
    padding: 3.5rem 2rem;
    font-family: var(--font-serif);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .empty-icon {
    font-size: 2.8rem;
    opacity: 0.8;
  }

  .empty-title {
    font-size: 1.4rem;
    color: var(--color-ink-black);
    margin: 0;
  }

  .empty-desc {
    color: var(--color-ink-grey);
    font-size: 1rem;
    margin: 0;
  }

  .empty-btn {
    margin-top: 0.8rem;
    font-size: 0.95rem;
    padding: 0.5rem 1.4rem;
  }

  @media (max-width: 768px) {
    .timeline-line {
      left: 15px;
    }

    .timeline-dot {
      left: 12px;
      top: 8px;
    }

    .timeline-item {
      flex-direction: column;
      gap: 0.5rem;
      padding-left: 35px;
    }

    .post-date {
      width: 100%;
      text-align: left;
      font-size: 0.85rem;
      padding-bottom: 0.2rem;
    }

    .post-card-wrapper {
      width: 100%;
      margin-left: 0;
    }

    .post-card {
      padding: 1.2rem 1.5rem;
    }

    .page-title {
      font-size: 2.8rem;
    }
  }
</style>
