---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ShimmerBadge from '../../components/ui/ShimmerBadge.astro';
import { BLOG_CATEGORY_LIST, getCategoryInfo } from '../../utils/blogCategories';
import { BLOG_DIALOGUES } from '../../data/blogDialogues';

// 獲取所有部落格文章並按發布日期排序 (降序)
const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 計算各分類的文章數量與最新文章
const categoryStats = BLOG_CATEGORY_LIST.map((category) => {
  const postsInCategory = allPosts.filter(
    (post) => (post.data.category || 'daily') === category.id
  );
  return {
    ...category,
    count: postsInCategory.length,
    latestPost: postsInCategory.length > 0 ? postsInCategory[0] : null,
  };
});

// 格式化日期
const formatDate = (date: Date) => {
  return date.toLocaleDateString('zh-Hant', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<Layout title="觀其文 · 文章專欄 | 晚餐後的書桌" description="晚餐飯後根據每天學到、想到的東西趕在忘記以前記錄下來，分為技術筆記、日常心得、思考練習與閱讀心得四個專欄。">
  <div class="blog-portal-container">
    
    <!-- 頁面書法標題 -->
    <header class="blog-header ink-fade-in">
      <h1 class="cursive-title page-title">觀其文</h1>
      <p class="blog-desc">你想要看哪一類的貼文呢。</p>
      <div class="mountain-line"></div>
    </header>

    <!-- 四大分類引導卡片 (Portal Cards) -->
    <section class="category-grid ink-fade-in" style="animation-delay: 0.15s;" aria-label="文章分類">
      {categoryStats.map((cat, index) => {
        const catDialogue = BLOG_DIALOGUES[cat.id as keyof typeof BLOG_DIALOGUES];
        return (
          <div class="category-card-wrapper" data-wrapper-cat-id={cat.id}>
            <!-- 專欄主體卡片 -->
            <a 
              href={`${import.meta.env.BASE_URL}blog/category/${cat.id}/`} 
              class="category-portal-card paper-card"
              data-cat-id={cat.id}
              data-category-desc={cat.description}
              style={`--cat-color: ${cat.color}; --cat-accent: ${cat.accentColor}; animation-delay: ${0.1 * index}s;`}
              data-astro-prefetch="hover"
            >
              <!-- 懸停時彈出的古風水墨對話氣泡 (Typewriter Tooltip) -->
              <div class="ink-dialog-bubble" aria-hidden="true">
                <div class="bubble-arrow"></div>
                <div class="bubble-inner">
                  <span class="bubble-badge-icon">{cat.icon}</span>
                  <span class="bubble-typing-text"></span>
                  <span class="ink-cursor"></span>
                </div>
              </div>

              <div class="cat-card-top">
                <div class="cat-seal" style={`background-color: ${cat.color};`}>
                  {cat.badgeText}
                </div>
                <div class="cat-count-badge">
                  {cat.count > 0 ? `${cat.count} 篇貼文` : '暫無存墨'}
                </div>
              </div>

              <div class="cat-card-body">
                <div class="cat-title-row">
                  <span class="cat-icon">{cat.icon}</span>
                  <h2 class="cat-title">{cat.name}</h2>
                </div>
              </div>

              <div class="cat-card-footer">
                {cat.latestPost ? (
                  <div class="cat-latest-preview">
                    <span class="preview-label">最新：</span>
                    <span class="preview-title">{cat.latestPost.data.title}</span>
                  </div>
                ) : (
                  <span class="cat-empty-hint">靜待啟筆...</span>
                )}
                <span class="cat-enter-link">進入專欄 →</span>
              </div>
            </a>

            <!-- 卡片逃跑後的純淨隱形佔位區 (方案 C：平日完全空白，Hover 時微弱浮現) -->
            <div class="category-note-card" data-note-cat-id={cat.id} style="display: none;">
              <div class="note-ghost-content">
                <p class="note-msg">{catDialogue?.noteMessage || '【節點離線】管理員已出走。'}</p>
                <div class="note-actions">
                  <button type="button" class="btn-coax-back" data-coax-id={cat.id} title="哄專欄管理員回來">
                    哄回來
                  </button>
                  {catDialogue?.easterEggLink && (
                    <a 
                      href={catDialogue.easterEggLink.url} 
                      target="_blank" 
                      rel="nofollow noopener noreferrer" 
                      class="note-easter-link"
                    >
                      {catDialogue.easterEggLink.text}
                    </a>
                  )}
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </section>

    <!-- 全覽專區分割標題 -->
    <section class="all-posts-section ink-fade-in" style="animation-delay: 0.3s;">
      <div class="section-divider">
        <span class="divider-line"></span>
        <h2 class="section-subtitle cursive-title">全部文章</h2>
        <span class="divider-line"></span>
      </div>

      <!-- 時間軸文章列表 -->
      <div class="posts-timeline">
        {allPosts.length === 0 ? (
          <div class="paper-card no-posts">
            <p>晚餐偷懶啦~~ 趕緊催一下晚餐吧!!</p>
          </div>
        ) : (
          <div class="timeline-wrapper">
            <!-- 時間軸的垂直貫穿水墨線 -->
            <div class="timeline-line"></div>
            
            {allPosts.map((post, index) => {
              const catInfo = getCategoryInfo(post.data.category);
              return (
                <article class="timeline-item" style={`animation-delay: ${0.08 * index}s;`}>
                  <!-- 時間軸的小墨點錨點 -->
                  <div class="timeline-dot" style={`--dot-color: ${catInfo.color};`}></div>
                  
                  <!-- 文章發布時間 -->
                  <div class="post-date">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {formatDate(post.data.pubDate)}
                    </time>
                  </div>

                  <!-- 文章卡片內容 -->
                  <div class="post-card-wrapper">
                    <a href={`${import.meta.env.BASE_URL}blog/${post.slug}/`} class="post-link-card" data-astro-prefetch="hover">
                      <div class="paper-card post-card" style={`--card-cat-color: ${catInfo.color};`}>
                        
                        <!-- 分類與主題標記 -->
                        <div class="post-top-meta">
                          <span class="category-pill" style={`background-color: ${catInfo.color};`}>
                            {catInfo.name}
                          </span>
                          {post.data.topic && (
                            <span class="topic-label">
                              <span class="topic-dot"></span>
                              {post.data.topic}
                            </span>
                          )}
                        </div>

                        <h3 class="post-title">{post.data.title}</h3>
                        <p class="post-description">{post.data.description}</p>
                        
                        <div class="post-meta">
                          <!-- 標籤 -->
                          {post.data.tags && post.data.tags.length > 0 && (
                            <div class="post-tags">
                              {post.data.tags.map((tag) => (
                                <ShimmerBadge text={`# ${tag}`} variant="default" />
                              ))}
                            </div>
                          )}
                          
                          <!-- 閱讀更多 -->
                          <span class="read-more-link ink-link">閱全文 →</span>
                        </div>
                      </div>
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </div>
    </section>

  </div>
</Layout>

<style>
  .blog-portal-container {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .blog-header {
    text-align: center;
  }

  .page-title {
    font-size: 3.8rem;
    color: var(--color-ink-black);
    margin-bottom: 0.5rem;
  }

  .blog-desc {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--color-ink-grey);
    letter-spacing: 0.08em;
  }

  /* 四大分類卡片網格 */
  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.2rem 1.8rem;
    margin-top: 1.2rem;
  }

  .category-card-wrapper {
    position: relative;
    min-height: 230px;
    border-radius: 12px;
    overflow: visible;
  }

  .category-portal-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    min-height: 230px;
    padding: 1.8rem;
    border-radius: 12px;
    border-left: 4px solid var(--cat-color, var(--color-border));
    text-decoration: none;
    transition: box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-left-width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: visible; /* 允許上方浮動氣泡顯示 */
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(245, 240, 227, 0.6) 100%);
    box-sizing: border-box;
  }

  /* 逃跑後的隱形佔位層 (方案 C：平日完全空白，Hover 時微弱浮現) */
  .category-note-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 100%;
    min-height: 230px;
    padding: 1.5rem;
    background: transparent;
    border: 1px dashed rgba(0, 0, 0, 0.04);
    border-radius: 12px;
    position: relative;
    box-sizing: border-box;
    transition: all 0.3s ease;
  }

  .note-ghost-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.9rem;
    width: 100%;
    opacity: 0;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* 滑鼠移入空白區域時才微弱顯現 */
  .category-note-card:hover {
    background: rgba(255, 255, 255, 0.45);
    border-color: rgba(0, 0, 0, 0.12);
  }

  .category-note-card:hover .note-ghost-content {
    opacity: 1;
  }

  .note-msg {
    font-family: var(--font-serif);
    font-size: 0.88rem;
    color: var(--color-ink-grey, #777);
    margin: 0;
    letter-spacing: 0.05em;
  }

  .note-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    width: 100%;
    margin-top: 0.2rem;
  }

  .btn-coax-back {
    display: inline-block;
    background: #ffffff;
    border: 1px solid var(--color-ink-black, #333333);
    color: var(--color-ink-black, #222222);
    padding: 0.35rem 1.2rem;
    border-radius: 4px;
    font-family: var(--font-serif);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    letter-spacing: 0.1em;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
    transition: all 0.2s ease;
  }

  .btn-coax-back:hover {
    background: var(--color-ink-black, #222222);
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.15);
  }

  /* 偽裝成不起眼的小備註釣魚連結 */
  .note-easter-link {
    font-family: var(--font-serif);
    font-size: 0.76rem;
    color: var(--color-ink-grey, #888);
    text-decoration: none;
    letter-spacing: 0.03em;
    opacity: 0.7;
    transition: all 0.2s ease;
  }

  .note-easter-link:hover {
    color: #9b2c2c;
    opacity: 1;
    text-decoration: underline;
  }

  .category-portal-card::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 80px;
    height: 80px;
    border-radius: 0 12px 0 0;
    background: radial-gradient(circle, var(--cat-accent) 0%, transparent 70%);
    pointer-events: none;
    transition: all 0.4s ease;
  }

  .category-portal-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
    border-left-width: 6px;
  }

  .category-portal-card:hover::before {
    width: 140px;
    height: 140px;
  }

  /* 懸停水墨對話氣泡 Tooltip */
  .ink-dialog-bubble {
    position: absolute;
    bottom: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    width: 90%;
    max-width: 360px;
    min-height: 52px;
    padding: 0.75rem 1rem;
    background: var(--color-paper-bg, #fdfbf7);
    border: 1.5px solid var(--cat-color, var(--color-ink-black));
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12), 0 2px 6px rgba(0, 0, 0, 0.04);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 50;
    transition: opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), 
                visibility 0.28s;
  }

  .category-portal-card:hover .ink-dialog-bubble {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  /* 氣泡向下小尖角 */
  .bubble-arrow {
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 10px;
    height: 10px;
    background: var(--color-paper-bg, #fdfbf7);
    border-right: 1.5px solid var(--cat-color, var(--color-ink-black));
    border-bottom: 1.5px solid var(--cat-color, var(--color-ink-black));
  }

  .bubble-inner {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-family: var(--font-serif);
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--color-ink-black);
    text-align: left;
  }

  .bubble-badge-icon {
    font-size: 1rem;
    line-height: 1.3;
    flex-shrink: 0;
  }

  .bubble-typing-text {
    flex: 1;
    color: var(--color-ink-text);
    font-weight: 500;
  }

  /* 水墨打字光標 */
  .ink-cursor {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    background-color: var(--cat-color, var(--color-ink-black));
    vertical-align: -2px;
    margin-left: 2px;
    animation: inkCursorBlink 0.75s infinite ease-in-out;
  }

  @keyframes inkCursorBlink {
    0%, 100% {
      opacity: 1;
      transform: scaleY(1);
    }
    50% {
      opacity: 0.1;
      transform: scaleY(0.7);
    }
  }

  .cat-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2rem;
  }

  .cat-seal {
    width: 38px;
    height: 38px;
    border-radius: 6px;
    color: #ffffff;
    font-family: var(--font-cursive);
    font-size: 1.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
  }

  .cat-count-badge {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    color: var(--color-ink-grey);
    background: rgba(0, 0, 0, 0.04);
    padding: 0.25rem 0.7rem;
    border-radius: 12px;
    letter-spacing: 0.05em;
  }

  .cat-card-body {
    margin: 1.2rem 0 1.5rem 0;
  }

  .cat-title-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .cat-icon {
    font-size: 1.4rem;
  }

  .cat-title {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-ink-black);
    margin: 0;
  }

  .cat-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px dashed rgba(200, 190, 170, 0.5);
    padding-top: 1rem;
    font-family: var(--font-serif);
    font-size: 0.9rem;
  }

  .cat-latest-preview {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    max-width: 65%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--color-ink-grey);
  }

  .preview-label {
    font-size: 0.8rem;
    opacity: 0.8;
  }

  .preview-title {
    font-size: 0.85rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--color-ink-text);
  }

  .cat-empty-hint {
    color: var(--color-ink-grey);
    font-size: 0.85rem;
    font-style: italic;
  }

  .cat-enter-link {
    font-weight: 600;
    color: var(--cat-color, var(--color-ink-black));
    transition: transform 0.2s ease;
  }

  .category-portal-card:hover .cat-enter-link {
    transform: translateX(4px);
  }

  /* 全覽專區分割標題 */
  .section-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--color-border), transparent);
  }

  .section-subtitle {
    font-size: 2.2rem;
    color: var(--color-ink-black);
    margin: 0;
    white-space: nowrap;
  }

  /* 時間軸架構 */
  .posts-timeline {
    position: relative;
    padding: 1rem 0;
  }

  .timeline-wrapper {
    position: relative;
  }

  .timeline-line {
    position: absolute;
    left: 200px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: linear-gradient(
      to bottom,
      var(--color-ink-light) 0%,
      var(--color-border) 50%,
      transparent 100%
    );
    opacity: 0.5;
  }

  .timeline-item {
    position: relative;
    display: flex;
    margin-bottom: 3.5rem;
    align-items: flex-start;
  }

  .timeline-dot {
    position: absolute;
    left: 197px;
    top: 12px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--dot-color, var(--color-ink-black));
    border: 2px solid var(--color-paper-bg);
    box-shadow: 0 0 8px rgba(0, 0, 0, 0.2);
    z-index: 5;
    transition: var(--transition-fast);
  }

  .timeline-item:hover .timeline-dot {
    transform: scale(1.4);
    box-shadow: 0 0 12px rgba(0, 0, 0, 0.3);
  }

  .post-date {
    width: 170px;
    text-align: right;
    padding-top: 5px;
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: var(--color-ink-grey);
    letter-spacing: 0.05em;
  }

  .post-card-wrapper {
    flex: 1;
    margin-left: 55px;
  }

  .post-link-card {
    display: block;
    text-decoration: none;
  }

  .post-card {
    padding: 1.8rem 2rem;
    border-left: 3px solid var(--card-cat-color, var(--color-border));
    transition: all 0.3s ease;
  }

  .post-card:hover {
    transform: translateX(4px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
  }

  .post-top-meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.8rem;
  }

  .category-pill {
    font-family: var(--font-serif);
    font-size: 0.75rem;
    color: #ffffff;
    padding: 0.15rem 0.6rem;
    border-radius: 4px;
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  .topic-label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-serif);
    font-size: 0.85rem;
    color: var(--color-ink-grey);
  }

  .topic-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--color-ink-grey);
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-ink-black);
    margin-bottom: 0.8rem;
    transition: var(--transition-fast);
  }

  .post-description {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink-text);
    margin-bottom: 1.5rem;
    text-align: justify;
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    border-top: 1px dashed rgba(230, 223, 204, 0.6);
    padding-top: 1rem;
  }

  .post-tags {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .read-more-link {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-ink-black);
  }

  .post-link-card:hover .read-more-link {
    color: var(--color-mountain-cyan);
  }

  .no-posts {
    text-align: center;
    padding: 3rem;
    font-family: var(--font-serif);
    color: var(--color-ink-grey);
  }

  /* Steam 風格水墨黑金成就 Toast 通知 */
  :global(.steam-toast-container) {
    position: fixed;
    bottom: 24px;
    right: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 9999;
    pointer-events: none;
  }

  :global(.steam-toast-card) {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    background: linear-gradient(135deg, rgba(28, 25, 23, 0.96) 0%, rgba(44, 39, 36, 0.94) 100%);
    border: 1.5px solid rgba(212, 163, 89, 0.6);
    border-radius: 10px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35), 0 0 15px rgba(212, 163, 89, 0.2);
    color: #fdfbf7;
    min-width: 280px;
    max-width: 360px;
    position: relative;
    overflow: hidden;
    pointer-events: auto;
    backdrop-filter: blur(10px);
  }

  :global(.steam-toast-shimmer) {
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.15), transparent);
    transform: skewX(-20deg);
    animation: steamShimmer 2.5s infinite;
  }

  @keyframes steamShimmer {
    0% { left: -100%; }
    100% { left: 200%; }
  }

  :global(.steam-toast-left) {
    flex-shrink: 0;
  }

  :global(.steam-toast-badge) {
    width: 42px;
    height: 42px;
    border-radius: 8px;
    background: linear-gradient(135deg, #d4a359 0%, #b8860b 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  :global(.steam-toast-content) {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  :global(.steam-toast-tag) {
    font-family: var(--font-serif);
    font-size: 0.72rem;
    color: #d4a359;
    letter-spacing: 0.1em;
    font-weight: 700;
    text-transform: uppercase;
  }

  :global(.steam-toast-title) {
    font-family: var(--font-serif);
    font-size: 0.96rem;
    font-weight: 700;
    color: #ffffff;
  }

  :global(.steam-toast-desc) {
    font-family: var(--font-serif);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.35;
  }

  /* 行動端適配 */
  @media (max-width: 768px) {
    .category-grid {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }

    .timeline-line {
      left: 15px;
    }

    .timeline-dot {
      left: 12px;
      top: 8px;
    }

    .timeline-item {
      flex-direction: column;
      gap: 0.5rem;
      padding-left: 35px;
    }

    .post-date {
      width: 100%;
      text-align: left;
      font-size: 0.85rem;
      padding-bottom: 0.2rem;
    }

    .post-card-wrapper {
      width: 100%;
      margin-left: 0;
    }
    
    .post-card {
      padding: 1.2rem 1.5rem;
    }

    .page-title {
      font-size: 2.8rem;
    }

    .section-subtitle {
      font-size: 1.8rem;
    }

    :global(.steam-toast-container) {
      top: 20px;
      bottom: auto;
      right: 16px;
      left: 16px;
    }

    :global(.steam-toast-card) {
      max-width: 100%;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { BLOG_DIALOGUES } from '../../data/blogDialogues';
  import { achievementManager } from '../../utils/achievementSystem';

  // 斷句格式化器（優先依標點符號換行，避頭尾法則防孤字）
  function formatDialogueBreak(text: string, maxLineLen = 15): string {
    if (!text) return '';
    // 如果文本中已包含手動換行符 \n，直接採用
    if (text.includes('\n')) return text;

    const punctuations = ['，', '、', '。', '！', '？', '；', '：', '…', '—'];
    let result = '';
    let currentLine = '';

    for (let i = 0; i < text.length; i++) {
      const char = text[i];
      currentLine += char;

      // 當遇到標點符號，且目前行字數達到一定長度（大於等於 8 字）
      if (punctuations.includes(char) && currentLine.length >= 8 && i < text.length - 3) {
        result += currentLine + '\n';
        currentLine = '';
      } else if (currentLine.length >= maxLineLen && i < text.length - 2) {
        // 超長防破版強制斷行
        result += currentLine + '\n';
        currentLine = '';
      }
    }

    result += currentLine;
    return result;
  }

  // 隨機抽選不連續重複的台詞
  function getRandomQuote(quotes: string[], lastQuote?: string): string {
    if (!quotes || quotes.length === 0) return '';
    if (quotes.length === 1) return quotes[0];
    const pool = quotes.filter((q) => q !== lastQuote);
    const randomIndex = Math.floor(Math.random() * pool.length);
    return pool[randomIndex] || quotes[0];
  }

  // 初始化四大專欄卡片互動系統
  function initBlogCardInteractions() {
    const wrappers = document.querySelectorAll<HTMLElement>('.category-card-wrapper');
    if (wrappers.length === 0) return;

    // 儲存各專欄當前即時狀態
    const cardStates: Record<string, {
      hoverCount: number;
      resetTimer: number | null;
      lastQuote: string;
      isEscaped: boolean;
      originalIcon: string;
      isReturning: boolean;
      returnLockTimer: number | null;
    }> = {};

    wrappers.forEach((wrapper) => {
      const card = wrapper.querySelector<HTMLElement>('.category-portal-card');
      const note = wrapper.querySelector<HTMLElement>('.category-note-card');
      const coaxBtn = wrapper.querySelector<HTMLElement>('.btn-coax-back');
      const catId = card?.getAttribute('data-cat-id') as keyof typeof BLOG_DIALOGUES;

      if (!card || !catId || card.dataset.interactiveBound === 'true') return;
      card.dataset.interactiveBound = 'true';

      const dialogueData = BLOG_DIALOGUES[catId];
      const textContainer = card.querySelector<HTMLElement>('.bubble-typing-text');
      const iconContainer = card.querySelector<HTMLElement>('.bubble-badge-icon');
      const cursor = card.querySelector<HTMLElement>('.ink-cursor');
      const enterLink = card.querySelector<HTMLElement>('.cat-enter-link');
      const originalIcon = iconContainer?.textContent || '';

      cardStates[catId] = {
        hoverCount: 0,
        resetTimer: null,
        lastQuote: '',
        isEscaped: false,
        originalIcon: originalIcon,
        isReturning: false,
        returnLockTimer: null,
      };

      let typingTimer: number | null = null;

      const stopTyping = () => {
        if (typingTimer !== null) {
          window.clearTimeout(typingTimer);
          typingTimer = null;
        }
      };

      // 執行 Uiverse.io 旗艦級專屬逃跑/消失動畫
      const triggerEscapeAnimation = () => {
        console.log('[triggerEscapeAnimation] starting for', catId);
        const state = cardStates[catId];
        state.isEscaped = true;

        // 判定成就
        achievementManager.unlock('single10');
        
        // 檢查是否達成四專欄大滿貫
        const allEscaped = Object.keys(BLOG_DIALOGUES).every((id) => {
          return cardStates[id]?.hoverCount >= 10 || cardStates[id]?.isEscaped;
        });
        if (allEscaped) {
          achievementManager.unlock('all10');
        }

        card.style.pointerEvents = 'none';

        // 依不同風格執行專屬 GSAP 5 秒戲劇級旗艦動效
        if (catId === 'tech') {
          // 1. 技術筆記【5.0秒 駭客終端除錯崩潰與 CRT 斷電】
          // Phase 1 (0.0~1.4s): 橫向雜訊切片與高頻抖動
          // Phase 2 (1.4~3.5s): 核心過載脈衝、邊框震顫閃爍
          // Phase 3 (3.5~5.0s): CRT 垂直壓成細線、蓄力停留後水平聚縮湮滅
          const tl = gsap.timeline({
            onComplete: () => {
              console.log('[triggerEscapeAnimation] completed for', catId);
              card.style.display = 'none';
              card.style.pointerEvents = '';
              if (note) note.style.display = 'flex';
            },
          });
          tl.to(card, { x: -6, duration: 0.08, repeat: 7, yoyo: true, ease: 'none' })
            .to(card, { x: 8, skewX: 3, duration: 0.1, repeat: 5, yoyo: true })
            .to(card, { opacity: 0.65, scale: 0.97, duration: 0.35, yoyo: true, repeat: 3, ease: 'power1.inOut' })
            .to(card, { scale: 1.02, duration: 0.3, ease: 'elastic.out(1, 0.3)' })
            .to(card, { scaleY: 0.008, scaleX: 1.08, filter: 'brightness(2.5)', duration: 0.45, ease: 'power3.in' })
            .to(card, { scaleY: 0.008, scaleX: 1.08, duration: 0.45 }) // 維持光線蓄力
            .to(card, { scaleX: 0, opacity: 0, duration: 0.4, ease: 'power4.in' });
        } else if (catId === 'daily') {
          // 2. 日常心得【5.0秒 深度冬眠裹被窩大戲】
          // Phase 1 (0.0~1.4s): 大打呵欠、左右 Q 彈果凍形變
          // Phase 2 (1.4~3.5s): 裹緊被窩收縮成團、打呼起伏微震
          // Phase 3 (3.5~5.0s): 深陷床墊、旋轉沉入地底夢鄉
          const tl = gsap.timeline({
            onComplete: () => {
              console.log('[triggerEscapeAnimation] completed for', catId);
              card.style.display = 'none';
              card.style.pointerEvents = '';
              if (note) note.style.display = 'flex';
            },
          });
          tl.to(card, { scaleX: 1.18, scaleY: 0.82, duration: 0.35, ease: 'power1.out' })
            .to(card, { scaleX: 0.88, scaleY: 1.12, y: -14, duration: 0.4, ease: 'power1.out' })
            .to(card, { scaleX: 1.08, scaleY: 0.92, y: 0, duration: 0.35, ease: 'power1.inOut' })
            .to(card, { scaleX: 0.85, scaleY: 0.85, rotate: -3, duration: 0.55, ease: 'power1.inOut' })
            .to(card, { scaleX: 0.82, scaleY: 0.88, rotate: 3, duration: 0.75, yoyo: true, repeat: 1, ease: 'sine.inOut' }) // 打呼起伏
            .to(card, { scale: 0.65, y: 80, rotate: -6, opacity: 0, duration: 1.35, ease: 'power2.in' });
        } else if (catId === 'thinking') {
          // 3. 思考練習【5.0秒 傲嬌 4 步長征出走】
          // Phase 1 (0.0~1.0s): 推眼鏡別過頭、傲嬌後縮蓄力
          // Phase 2 (1.0~3.8s): 完整 4 步真實卡通步態循環（左右傾斜踏步）
          // Phase 3 (3.8~5.0s): 負氣加速大步流星跨出視窗邊界
          const tl = gsap.timeline({
            onComplete: () => {
              console.log('[triggerEscapeAnimation] completed for', catId);
              card.style.display = 'none';
              card.style.pointerEvents = '';
              if (note) note.style.display = 'flex';
            },
          });
          tl.to(card, { x: -25, scale: 0.96, rotate: -3, duration: 0.65, ease: 'power2.out' })
            .to(card, { x: -18, rotate: 0, duration: 0.35 })
            // 第 1 步 (左腳)
            .to(card, { x: 30, y: -16, rotate: -7, duration: 0.35, ease: 'power1.out' })
            .to(card, { y: 0, rotate: 0, duration: 0.25, ease: 'power1.in' })
            // 第 2 步 (右腳)
            .to(card, { x: 90, y: -16, rotate: 7, duration: 0.35, ease: 'power1.out' })
            .to(card, { y: 0, rotate: 0, duration: 0.25, ease: 'power1.in' })
            // 第 3 步 (左腳加急)
            .to(card, { x: 155, y: -14, rotate: -6, duration: 0.3, ease: 'power1.out' })
            .to(card, { y: 0, rotate: 0, duration: 0.2, ease: 'power1.in' })
            // 第 4 步 (右腳踏出邊緣)
            .to(card, { x: 225, y: -12, rotate: 5, duration: 0.25, ease: 'power1.out' })
            .to(card, { y: 0, rotate: 0, duration: 0.2, ease: 'power1.in' })
            // 衝出畫面
            .to(card, { x: '160%', opacity: 0, rotate: 8, duration: 0.9, ease: 'power2.in' });
        } else if (catId === 'reading') {
          // 4. 閱讀心得【5.0秒 3D 闔書與金光書籤升空大戲】
          // Phase 1 (0.0~1.2s): 書頁掀動沙沙作響
          // Phase 2 (1.2~2.8s): 3D 緩慢闔上，最後「啪！」重重拍合
          // Phase 3 (2.8~5.0s): 化身書籤空中懸浮並優雅升空抽離
          const tl = gsap.timeline({
            onComplete: () => {
              console.log('[triggerEscapeAnimation] completed for', catId);
              card.style.display = 'none';
              card.style.pointerEvents = '';
              if (note) note.style.display = 'flex';
            },
          });
          gsap.set(card, { transformOrigin: 'left center' });
          tl.to(card, { skewX: -4, rotateZ: 2, duration: 0.35, yoyo: true, repeat: 2, ease: 'sine.inOut' })
            .to(card, { rotateY: -60, scaleX: 0.6, duration: 0.9, ease: 'power1.in' })
            .to(card, { rotateY: -90, scaleX: 0.08, duration: 0.35, ease: 'power4.in' }) // 啪一聲拍合
            .to(card, { y: -10, duration: 0.1, yoyo: true, repeat: 1 }) // 拍合震顫
            .to(card, { y: -30, rotateZ: 5, duration: 0.8, ease: 'power1.out' }) // 懸浮書籤
            .to(card, { y: -240, x: -60, rotateZ: -15, opacity: 0, duration: 1.4, ease: 'power3.in' });
        }
      };

      // 滑鼠進入事件
      card.addEventListener('mouseenter', () => {
        const state = cardStates[catId];
        if (state.isEscaped || state.isReturning) return;

        // 清除 10 秒計時器
        if (state.resetTimer !== null) {
          window.clearTimeout(state.resetTimer);
          state.resetTimer = null;
        }

        state.hoverCount++;
        const count = state.hoverCount;
        console.log('[Blog Card]', catId, 'hoverCount:', count);

        // 決定當前階段的文字
        let currentRawQuote = '';
        if (count <= 3) {
          // 階段 1：正常隨機簡介
          currentRawQuote = getRandomQuote(dialogueData.normal, state.lastQuote);
          if (iconContainer) iconContainer.textContent = originalIcon;
          if (enterLink) enterLink.textContent = '進入專欄 →';
        } else if (count <= 6) {
          // 階段 2：微惱吐槽
          currentRawQuote = getRandomQuote(dialogueData.tease, state.lastQuote);
          if (iconContainer) iconContainer.textContent = originalIcon;
          if (enterLink) enterLink.textContent = '進入專欄 →';
        } else if (count <= 9) {
          // 階段 3：極度傲嬌
          currentRawQuote = getRandomQuote(dialogueData.tsundere, state.lastQuote);
          if (iconContainer) iconContainer.textContent = dialogueData.angryIcon;
          if (enterLink) enterLink.textContent = dialogueData.enterActionText;

          // 觸發傲嬌專屬微動效
          if (catId === 'tech') {
            gsap.fromTo(card, { x: -3 }, { x: 3, duration: 0.08, repeat: 4, yoyo: true, ease: 'none' });
          } else if (catId === 'daily') {
            gsap.to(card, { y: 4, opacity: 0.9, duration: 0.3 });
          } else if (catId === 'thinking') {
            gsap.fromTo(card, { rotate: -1 }, { rotate: 1, duration: 0.1, repeat: 3, yoyo: true });
          } else if (catId === 'reading') {
            gsap.fromTo(card, { scale: 0.98 }, { scale: 1.01, duration: 0.15, repeat: 1, yoyo: true });
          }
        } else {
          // 階段 4 (>=10)：最後逃跑遺言
          currentRawQuote = dialogueData.escapeQuote;
          if (iconContainer) iconContainer.textContent = dialogueData.angryIcon;
        }

        state.lastQuote = currentRawQuote;
        const formattedQuote = formatDialogueBreak(currentRawQuote);

        // 啟動打字機動畫
        stopTyping();
        if (textContainer) {
          textContainer.textContent = '';
          if (cursor) cursor.style.display = 'inline-block';

          let charIdx = 0;
          const typeChar = () => {
            if (charIdx <= formattedQuote.length) {
              textContainer.textContent = formattedQuote.slice(0, charIdx);
              charIdx++;
              if (charIdx <= formattedQuote.length) {
                typingTimer = window.setTimeout(typeChar, count >= 7 ? 18 : 25);
              } else if (count >= 10) {
                // 逃跑台詞打完後，短暫停留 600ms 觸發逃跑動畫
                window.setTimeout(triggerEscapeAnimation, 600);
              }
            }
          };
          typingTimer = window.setTimeout(typeChar, 60);
        }
      });

      // 滑鼠離開事件 (啟動 10 秒計數冷卻重置)
      card.addEventListener('mouseleave', () => {
        stopTyping();
        const state = cardStates[catId];
        if (state.isEscaped || state.isReturning) return;

        // 重置打字框
        if (textContainer) textContainer.textContent = '';
        if (enterLink && state.hoverCount < 7) enterLink.textContent = '進入專欄 →';

        // 10 秒後若未達到 10 次，將情緒階梯重置為 0
        state.resetTimer = window.setTimeout(() => {
          state.hoverCount = 0;
          if (iconContainer) iconContainer.textContent = originalIcon;
          if (enterLink) enterLink.textContent = '進入專欄 →';
        }, 10000);
      });

      // 點擊「哄回來」按鈕 (物理級清除殘留 + 賦歸台詞鎖定展示)
      if (coaxBtn) {
        coaxBtn.addEventListener('click', () => {
          const state = cardStates[catId];
          if (state.isReturning) return;
          state.isReturning = true;
          state.isEscaped = false;
          state.hoverCount = 0;

          // 物理級清除所有 GSAP 殘留屬性 (徹底根除黑化與變形)
          gsap.set(card, { clearProps: 'all' });
          if (note) note.style.display = 'none';
          card.style.display = 'flex';

          // 彈性活力蹦回原位
          gsap.fromTo(
            card,
            { scale: 0.75, opacity: 0, y: 15 },
            { scale: 1, opacity: 1, y: 0, duration: 0.55, ease: 'back.out(1.7)' }
          );

          // 在氣泡中短暫鎖定展示專屬「賦歸台詞」
          if (iconContainer) iconContainer.textContent = dialogueData.returnIcon;
          if (enterLink) enterLink.textContent = '進入專欄 →';

          stopTyping();
          if (textContainer) {
            textContainer.textContent = '';
            if (cursor) cursor.style.display = 'inline-block';

            const returnFormatted = formatDialogueBreak(dialogueData.returnQuote);
            let charIdx = 0;
            const typeReturnChar = () => {
              if (charIdx <= returnFormatted.length) {
                textContainer.textContent = returnFormatted.slice(0, charIdx);
                charIdx++;
                if (charIdx <= returnFormatted.length) {
                  typingTimer = window.setTimeout(typeReturnChar, 22);
                }
              }
            };
            typingTimer = window.setTimeout(typeReturnChar, 50);
          }

          // 鎖定展示 2.8 秒，結束後平滑解除鎖定
          if (state.returnLockTimer !== null) {
            window.clearTimeout(state.returnLockTimer);
          }
          state.returnLockTimer = window.setTimeout(() => {
            state.isReturning = false;
            state.returnLockTimer = null;
            if (iconContainer) iconContainer.textContent = originalIcon;
          }, 2800);
        });
      }
    });
  }

  // 僅使用單一入口確保生命週期純淨
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBlogCardInteractions, { once: true });
  } else {
    initBlogCardInteractions();
  }
  document.addEventListener('astro:page-load', initBlogCardInteractions);
</script>
