---
import { execFileSync } from "node:child_process";
import Layout from "../layouts/Layout.astro";
import InkButton from "../components/ui/InkButton.astro";
import ShimmerBadge from "../components/ui/ShimmerBadge.astro";

interface CommitLog {
  hash: string;
  shortHash: string;
  date: string;
  message: string;
}

let commitLogs: CommitLog[] = [];
try {
  const rawLog = execFileSync(
    "git",
    ["log", "-n", "5", "--pretty=format:%H|%h|%as|%s"],
    {
      encoding: "utf8",
      timeout: 5000,
    },
  );

  commitLogs = rawLog
    .trim()
    .split("\n")
    .filter(Boolean)
    .map((line) => {
      const [hash, shortHash, date, ...msgParts] = line.split("|");
      return {
        hash,
        shortHash,
        date,
        message: msgParts.join("|"),
      };
    });
} catch (e) {
  commitLogs = [];
}
---

<Layout
  title="晚餐後的書桌 | 立於岳麓，伏案浸墨"
  description="吃墨水的晚餐之個人創作空間「晚餐後的書桌」，收錄東方玄幻小說、修仙世界觀設定集、人物誌與技術隨筆。"
>
  <div class="home-container">
    <!-- 頂部書法字標題區 -->
    <section class="hero-section ink-fade-in">
      <h1 class="cursive-title main-heading">立於岳麓，伏案浸墨</h1>
      <div class="mountain-line"></div>
    </section>

    <!-- 個人簡介宣紙卡片 -->
    <section class="intro-section ink-fade-in" style="animation-delay: 0.2s;">
      <div class="paper-card profile-card">
        <h2 class="section-title">自序</h2>
        <p class="profile-text">
          晚餐只是個業餘的斜槓網路遊民，晚餐過後則沉浸在自己的世界裡，研究一些有的沒的。
        </p>
        <p class="profile-text">
          晚餐說:這個網站是用 <strong>Astro</strong> 框架所建。用來記錄技術探索，以及各類心得。
        </p>

        <div class="skills-showcase">
          <ShimmerBadge icon="⚡" variant="cyan">網頁代碼</ShimmerBadge>
          <ShimmerBadge icon="🎨" variant="default">水墨寫意</ShimmerBadge>
          <ShimmerBadge icon="🎵" variant="accent">絲竹樂音</ShimmerBadge>
        </div>
      </div>
    </section>

    <!-- 修訂日誌宣紙卡片 (E-E-A-T 活躍度與修訂歷史) -->
    {
      commitLogs.length > 0 && (
        <section
          class="changelog-section ink-fade-in"
          style="animation-delay: 0.3s;"
        >
          <div class="paper-card changelog-card">
            <div class="changelog-header">
              <h2 class="section-title">修訂日誌</h2>
              <a
                href="https://github.com/meng10730/meng10730.github.io/commits/main"
                target="_blank"
                rel="noopener noreferrer"
                class="changelog-more-link cursive-title"
                title="前往 GitHub 查看完整提交履歷"
              >
                全卷檢閱 ➔
              </a>
            </div>
            <ul class="commit-list" id="home-commit-list">
              {commitLogs.map((log) => (
                <li class="commit-item">
                  <div class="commit-dot" />
                  <div class="commit-content">
                    <div class="commit-meta">
                      <span class="commit-date">{log.date}</span>
                      <a
                        href={`https://github.com/meng10730/meng10730.github.io/commit/${log.hash}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="commit-hash-link"
                        title={`檢視 Commit ${log.shortHash}`}
                      >
                        #{log.shortHash}
                      </a>
                    </div>
                    <p class="commit-message">{log.message}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <script is:inline>
      async function syncLiveCommits() {
        const listEl = document.getElementById("home-commit-list");
        if (!listEl) return;
        try {
          const cacheKey = "meng_site_live_commits_v1";
          const cacheTimeKey = "meng_site_live_commits_time_v1";
          const cached = sessionStorage.getItem(cacheKey);
          const cacheTime = sessionStorage.getItem(cacheTimeKey);
          let commits = null;

          if (cached && cacheTime && Date.now() - Number(cacheTime) < 180000) {
            commits = JSON.parse(cached);
          } else {
            const res = await fetch(
              "https://api.github.com/repos/meng10730/meng10730.github.io/commits?per_page=5",
            );
            if (res.ok) {
              commits = await res.json();
              sessionStorage.setItem(cacheKey, JSON.stringify(commits));
              sessionStorage.setItem(cacheTimeKey, String(Date.now()));
            }
          }

          if (commits && Array.isArray(commits) && commits.length > 0) {
            listEl.innerHTML = commits
              .map((item) => {
                const hash = item.sha || "";
                const shortHash = hash.substring(0, 7);
                const rawDate = item.commit?.author?.date || "";
                const date = rawDate ? rawDate.split("T")[0] : "";
                const rawMsg = (item.commit?.message || "").split("\n")[0];
                return `
                <li class="commit-item">
                  <div class="commit-dot"></div>
                  <div class="commit-content">
                    <div class="commit-meta">
                      <span class="commit-date">${date}</span>
                      <a href="https://github.com/meng10730/meng10730.github.io/commit/${hash}" target="_blank" rel="noopener noreferrer" class="commit-hash-link" title="檢視 Commit ${shortHash}">#${shortHash}</a>
                    </div>
                    <p class="commit-message">${rawMsg}</p>
                  </div>
                </li>
              `;
              })
              .join("");
          }
        } catch (err) {}
      }

      document.addEventListener("astro:page-load", syncLiveCommits);
      syncLiveCommits();
    </script>

    <!-- 快速導覽按鈕區 -->
    <section
      class="navigation-section ink-fade-in"
      style="animation-delay: 0.4s;"
    >
      <div class="action-buttons">
        <InkButton href="/blog" variant="primary" size="md">
          <span>觀文揣墨</span>
          <svg
            slot="suffix"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="currentColor"
            class="bi bi-chevron-right"
            viewBox="0 0 16 16"
          >
            <path
              fill-rule="evenodd"
              d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"
            ></path>
          </svg>
        </InkButton>
        <InkButton
          href="https://github.com/meng10730"
          target="_blank"
          rel="noopener noreferrer"
          variant="secondary"
          size="md"
        >
          <span>探源究微</span>
        </InkButton>
      </div>
    </section>
  </div>
</Layout>

<style>
  .home-container {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    padding: 1rem 0;
  }

  .hero-section {
    text-align: center;
    padding: 2rem 0 1rem 0;
  }

  .main-heading {
    font-size: 4.5rem;
    color: var(--color-ink-black);
    margin-bottom: 0.5rem;
    text-shadow: 0 4px 10px rgba(0, 0, 0, 0.02);
  }

  .sub-heading {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-ink-grey);
    letter-spacing: 0.15em;
  }

  .section-title {
    font-family: var(--font-cursive);
    font-size: 2.2rem;
    font-weight: normal;
    color: var(--color-ink-black);
    margin-bottom: 1.5rem;
    position: relative;
    display: inline-block;
  }

  .section-title::after {
    content: "";
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 60%;
    height: 1.5px;
    background: linear-gradient(
      90deg,
      var(--color-mountain-green),
      transparent
    );
  }

  .profile-card {
    border-left: 4px solid var(--color-mountain-cyan); /* 用青綠線條點綴左邊框 */
  }

  .profile-text {
    font-size: 1.1rem;
    line-height: 1.9;
    color: var(--color-ink-text);
    margin-bottom: 1.2rem;
    text-align: justify;
  }

  .profile-text strong {
    color: var(--color-mountain-cyan);
    font-weight: 600;
  }

  .skills-showcase {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--color-border);
  }

  .skill-tag {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(230, 223, 204, 0.25);
    border: 1px solid rgba(230, 223, 204, 0.5);
    padding: 0.4rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    color: var(--color-ink-grey);
    transition: var(--transition-fast);
  }

  .skill-tag:hover {
    background: rgba(45, 95, 90, 0.08);
    border-color: var(--color-mountain-cyan);
    color: var(--color-mountain-cyan);
    transform: translateY(-2px);
  }

  .tag-icon {
    font-size: 1rem;
  }

  /* 修訂日誌宣紙卡片樣式 */
  .changelog-card {
    border-left: 4px solid var(--color-mountain-green);
  }

  .changelog-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
  }

  .changelog-more-link {
    font-size: 1.05rem;
    color: var(--color-mountain-cyan);
    text-decoration: none;
    transition: var(--transition-fast);
  }

  .changelog-more-link:hover {
    color: var(--color-ink-black);
    transform: translateX(3px);
  }

  .commit-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .commit-item {
    display: flex;
    gap: 1.2rem;
    position: relative;
    padding-bottom: 1.5rem;
  }

  .commit-item:last-child {
    padding-bottom: 0;
  }

  .commit-item::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 10px;
    bottom: 0;
    width: 1px;
    background: rgba(230, 223, 204, 0.8);
  }

  .commit-item:last-child::before {
    display: none;
  }

  .commit-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-paper-light);
    border: 2px solid var(--color-mountain-cyan);
    margin-top: 5px;
    flex-shrink: 0;
    z-index: 2;
  }

  .commit-content {
    flex: 1;
  }

  .commit-meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.3rem;
  }

  .commit-date {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    color: var(--color-ink-grey);
  }

  .commit-hash-link {
    font-family: monospace;
    font-size: 0.8rem;
    color: var(--color-mountain-cyan);
    background: rgba(45, 95, 90, 0.08);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    text-decoration: none;
    transition: var(--transition-fast);
  }

  .commit-hash-link:hover {
    background: var(--color-mountain-cyan);
    color: var(--color-paper-light);
  }

  .commit-message {
    font-size: 0.95rem;
    color: var(--color-ink-text);
    line-height: 1.6;
    margin: 0;
    word-break: break-word;
  }

  /* 導覽按鈕區 */
  .action-buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }

  .action-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 2rem;
    border-radius: 4px;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.05rem;
    transition: var(--transition-smooth);
  }

  .primary-btn {
    background: var(--color-ink-black);
    color: var(--color-paper-light);
    border: 1px solid var(--color-ink-black);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
  }

  .primary-btn:hover {
    background: var(--color-mountain-cyan);
    border-color: var(--color-mountain-cyan);
    color: var(--color-paper-light);
    box-shadow: 0 6px 20px rgba(45, 95, 90, 0.2);
    transform: translateY(-2px);
  }

  .secondary-btn {
    background: transparent;
    color: var(--color-ink-text);
    border: 1.5px solid var(--color-border);
  }

  .secondary-btn:hover {
    background: rgba(230, 223, 204, 0.2);
    border-color: var(--color-ink-light);
    transform: translateY(-2px);
  }

  /* 響應式微調 */
  @media (max-width: 768px) {
    .main-heading {
      font-size: 3.2rem;
    }
    .sub-heading {
      font-size: 1.05rem;
    }
    .action-buttons {
      flex-direction: column;
      gap: 1rem;
      width: 100%;
    }
    .action-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
