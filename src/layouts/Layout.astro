---
import { ViewTransitions } from "astro:transitions";
import "../styles/global.css";
import InkCanvas from "../components/InkCanvas.astro";
import AudioPlayer from "../components/AudioPlayer.astro";
import GlossaryPopover from "../components/GlossaryPopover.astro";

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleDate?: Date | string;
  articleModified?: Date | string;
  type?: 'website' | 'article';
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title = "立於岳麓，伏案浸墨 | 晚餐後的書桌",
  description = "吃墨水的晚餐之個人創作空間「晚餐後的書桌」，收錄東方玄幻小說、修仙世界觀設定集、人物誌與技術隨筆。",
  image = "/favicon.svg",
  articleDate,
  articleModified,
  type = "website",
  breadcrumbs = [],
} = Astro.props;

const siteUrl = "https://meng10730.github.io";
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const socialImageURL = new URL(image, siteUrl).href;

const authorData = {
  "@type": "Person",
  "name": "吃墨水的晚餐",
  "url": siteUrl,
  "sameAs": [
    "https://github.com/meng10730"
  ]
};

const copyrightNotice = "版權所有 © 2026 吃墨水的晚餐，未經書面許可嚴禁任何形式之轉載、重製或用於 AI 機器學習訓練。";
const copyrightUrl = `${siteUrl}/copyright`;

const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
  "@type": "BreadcrumbList",
  "@id": `${canonicalURL}#breadcrumb`,
  "itemListElement": breadcrumbs.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": item.url.startsWith("http") ? item.url : new URL(item.url, siteUrl).href
  }))
} : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "晚餐後的書桌",
      "description": "吃墨水的晚餐之個人創作空間，收錄東方玄幻小說、修仙世界觀設定集、人物誌與技術隨筆",
      "author": authorData,
      "publisher": authorData,
      "copyrightHolder": authorData,
      "copyrightNotice": copyrightNotice,
      "license": copyrightUrl,
      "inLanguage": "zh-Hant"
    },
    ...(breadcrumbSchema ? [breadcrumbSchema] : []),
    ...(type === "article" || articleDate ? [
      {
        "@type": "Article",
        "@id": `${canonicalURL}#article`,
        "isPartOf": { "@id": `${siteUrl}/#website` },
        "headline": title,
        "description": description,
        "mainEntityOfPage": canonicalURL,
        "datePublished": articleDate ? new Date(articleDate).toISOString() : undefined,
        "dateModified": (articleModified || articleDate) ? new Date(articleModified || articleDate).toISOString() : undefined,
        "author": authorData,
        "publisher": authorData,
        "copyrightHolder": authorData,
        "copyrightNotice": copyrightNotice,
        "license": copyrightUrl,
        "inLanguage": "zh-Hant"
      }
    ] : [])
  ]
};
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- 基礎 SEO & E-E-A-T 標籤 -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="author" content="吃墨水的晚餐" />

    <!-- Open Graph (Facebook, LINE, Discord) -->
    <meta property="og:site_name" content="晚餐後的書桌" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- Google 結構化資料 (Schema.org / JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- 啟用 Astro 的客戶端路由（前身為 ViewTransitions）以達成無縫音樂與動畫 -->
    <ViewTransitions />
  </head>
  <body>
    <!-- 寫意水墨 Canvas 背景 -->
    <InkCanvas />

    <!-- 全站主排版 -->
    <div class="site-wrapper">
      <!-- 新中式導航列 -->
      <header class="site-header ink-fade-in">
        <nav class="nav-container">
          <div class="nav-logo">
            <a href={import.meta.env.BASE_URL} class="cursive-title ink-logo"
              >晚餐後的書桌</a
            >
          </div>
          <ul class="nav-links">
            <li>
              <a href={import.meta.env.BASE_URL} class="ink-link nav-item"
                >首頁</a
              >
            </li>
            <li>
              <a
                href={`${import.meta.env.BASE_URL}blog`}
                class="ink-link nav-item">文章</a
              >
            </li>
            <li>
              <a
                href={`${import.meta.env.BASE_URL}works`}
                class="ink-link nav-item">作品</a
              >
            </li>
            <li>
              <a
                href={`${import.meta.env.BASE_URL}shanzhuang`}
                class="ink-link nav-item">後山</a
              >
            </li>
            <li>
              <a
                href={`${import.meta.env.BASE_URL}about`}
                class="ink-link nav-item">關於</a
              >
            </li>
            <li>
              <a
                href={`${import.meta.env.BASE_URL}keystatic`}
                class="ink-link nav-item admin-login-btn"
                id="admin-login-btn"
                data-astro-reload>登入</a
              >
            </li>
            <li id="admin-logout-item" style="display: none;">
              <a
                href="#"
                class="ink-link nav-item admin-logout-btn"
                id="admin-logout-btn">登出</a
              >
            </li>
          </ul>
        </nav>
      </header>

      <script is:inline>
        function checkAdminStatus() {
          const btn = document.getElementById("admin-login-btn");
          const logoutItem = document.getElementById("admin-logout-item");
          if (btn) {
            try {
              // 1. 優先嘗試從 LocalStorage 讀取官方真正的 key: keystatic-cloud-access-token
              let token = localStorage.getItem("keystatic-cloud-access-token");

              // 2. 備用：從 Cookie 讀取 keystatic-github-token 或是 keystatic-cloud-access-token
              if (!token) {
                const cookies = document.cookie.split(";");
                for (let i = 0; i < cookies.length; i++) {
                  const pair = cookies[i].split("=");
                  const name = pair[0].trim();
                  if (
                    name === "keystatic-github-token" ||
                    name === "keystatic-cloud-access-token"
                  ) {
                    token = pair[1] ? pair[1].trim() : null;
                    break;
                  }
                }
              }

              // 3. 備用：舊版的 keystatic-github-token
              if (!token) {
                token = localStorage.getItem("keystatic-github-token");
              }

              // 4. 備用啟發式搜尋 (尋找任何長度大於 10 且包含 keystatic 或 token 關鍵字的 localStorage 項)
              if (!token) {
                for (let i = 0; i < localStorage.length; i++) {
                  const key = localStorage.key(i);
                  if (
                    key &&
                    (key.includes("keystatic") || key.includes("token"))
                  ) {
                    const val = localStorage.getItem(key);
                    if (val && val.length > 10) {
                      token = val;
                      break;
                    }
                  }
                }
              }

              if (token) {
                btn.textContent = "進入後台";
                btn.title = "您已登入 GitHub 管理者帳號";
                if (logoutItem) logoutItem.style.display = "block";
              } else {
                btn.textContent = "登入";
                btn.title = "登入 GitHub 進行文章編輯";
                if (logoutItem) logoutItem.style.display = "none";
              }
            } catch (e) {
              // 防禦沙箱環境限制
            }
          }
        }

        function setupLogout() {
          const logoutBtn = document.getElementById("admin-logout-btn");
          if (logoutBtn) {
            logoutBtn.addEventListener("click", function (e) {
              e.preventDefault();
              try {
                // 1. 清除 localStorage 特定 token 與 state keys
                localStorage.removeItem("keystatic-cloud-access-token");
                localStorage.removeItem("keystatic-cloud-state");
                localStorage.removeItem("keystatic-github-token");

                // 2. 清除 Cookie 狀態 (涵蓋 Path=/ 與 Path=/keystatic)
                document.cookie =
                  "keystatic-github-token=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;";
                document.cookie =
                  "keystatic-github-token=; Path=/keystatic; Expires=Thu, 01 Jan 1970 00:00:01 GMT;";
                document.cookie =
                  "keystatic-cloud-access-token=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;";
                document.cookie =
                  "keystatic-cloud-access-token=; Path=/keystatic; Expires=Thu, 01 Jan 1970 00:00:01 GMT;";

                // 3. 啟發式清理含有 keystatic 關鍵字之本地快取
                for (let i = localStorage.length - 1; i >= 0; i--) {
                  const key = localStorage.key(i);
                  if (
                    key &&
                    (key.includes("keystatic") || key.includes("token"))
                  ) {
                    localStorage.removeItem(key);
                  }
                }

                checkAdminStatus();
                if (window.location.pathname.startsWith("/keystatic")) {
                  window.location.href = "/";
                }
              } catch (err) {}
            });
          }
        }

        function initScrollTracker() {
          const path = window.location.pathname;
          // 比對是否在詳情頁，如 /shanzhuang/novels/tianxia
          const match = path.match(
            /\/shanzhuang\/(novels|characters|worldview|factions|guoxue)\/([^\/]+)\/?$/,
          );
          if (!match) return;

          const type = match[1];
          const slug = decodeURIComponent(match[2]);

          const titleEl = document.querySelector("h1");
          const title = titleEl
            ? titleEl.innerText.trim()
            : document.title.split("|")[0].trim();

          let scrollTimeout;

          function saveProgress() {
            try {
              const docHeight =
                document.documentElement.scrollHeight - window.innerHeight;
              if (docHeight <= 0) return;

              const percent = window.scrollY / docHeight;

              const record = {
                title: title,
                url: path,
                percent: percent,
                type: type,
                slug: slug,
                updatedAt: new Date().toISOString(),
              };
              localStorage.setItem(
                "shanzhuang_last_read",
                JSON.stringify(record),
              );
            } catch (e) {}
          }

          window.addEventListener("scroll", function () {
            if (scrollTimeout) clearTimeout(scrollTimeout);
            scrollTimeout = setTimeout(saveProgress, 300);
          });

          window.addEventListener("beforeunload", saveProgress);

          // 滾動回上次閱讀位置 (防非同步圖片載入抖動與二次定位校準)
          try {
            const raw = localStorage.getItem("shanzhuang_last_read");
            if (raw) {
              const record = JSON.parse(raw);
              if (
                record.url === path &&
                record.percent > 0.02 &&
                record.percent < 0.98
              ) {
                const performScroll = () => {
                  const docHeight =
                    document.documentElement.scrollHeight - window.innerHeight;
                  if (docHeight > 0) {
                    window.scrollTo({
                      top: docHeight * record.percent,
                      behavior: "smooth",
                    });

                    // 定位後加載微幅校準：在滾動動畫大致完成後（800ms）再次微調，防止滾動期間排版微幅改變
                    setTimeout(() => {
                      const currentDocHeight =
                        document.documentElement.scrollHeight -
                        window.innerHeight;
                      window.scrollTo({
                        top: currentDocHeight * record.percent,
                        behavior: "auto",
                      });
                    }, 800);
                  }
                };

                // 檢查是否所有圖片都已載入完成
                const images = Array.from(document.images);
                const promises = images.map((img) => {
                  if (img.complete) return Promise.resolve();
                  return new Promise((resolve) => {
                    img.addEventListener("load", resolve);
                    img.addEventListener("error", resolve); // 錯誤也當作載入完畢，避免卡死
                  });
                });

                // 設定最長等待時間 800ms，避免圖片掛掉或載入過久導致卡死
                const timeoutPromise = new Promise((resolve) =>
                  setTimeout(resolve, 800),
                );

                Promise.race([Promise.all(promises), timeoutPromise]).then(
                  () => {
                    // 圖片載入完成（或超時）後再等 100ms 讓瀏覽器重新排版，隨即執行定位
                    setTimeout(performScroll, 100);
                  },
                );
              }
            }
          } catch (e) {}
        }

        // --- 全域古風按鍵音效系統 (Web Audio API) ---
        let audioCtx = null;
        const sfxBuffers = {
          normal: null,
          high: null,
          low: null,
        };

        async function loadSfx(name, url) {
          try {
            const response = await fetch(url);
            const arrayBuffer = await response.arrayBuffer();
            if (audioCtx) {
              sfxBuffers[name] = await audioCtx.decodeAudioData(arrayBuffer);
            }
          } catch (err) {
            // 僅本地偵錯或靜默降級，不影響使用者
          }
        }

        async function initWebAudioSfx() {
          if (audioCtx) return;
          const AudioContextClass =
            window.AudioContext || window.webkitAudioContext;
          if (!AudioContextClass) return;
          audioCtx = new AudioContextClass();

          await Promise.all([
            loadSfx("normal", "/audio/click.wav"),
            loadSfx("high", "/audio/click-high.wav"),
            loadSfx("low", "/audio/click-low.wav"),
          ]);
        }

        function playClickSfx(type) {
          try {
            // 獨立讀取 LocalStorage 開關 (預設啟用)
            if (
              localStorage.getItem("shanzhuang_sfx_click_enabled") === "false"
            )
              return;

            if (!audioCtx) {
              initWebAudioSfx().then(() => triggerBufferPlay(type));
              return;
            }
            if (audioCtx.state === "suspended") {
              audioCtx.resume();
            }
            triggerBufferPlay(type);
          } catch (e) {}
        }

        function triggerBufferPlay(type) {
          const buffer = sfxBuffers[type];
          if (!buffer || !audioCtx) return;
          const source = audioCtx.createBufferSource();
          source.buffer = buffer;

          // 建立增益節點以將音效音量優化放大
          const gainNode = audioCtx.createGain();
          gainNode.gain.setValueAtTime(60, audioCtx.currentTime); // 放大 3.5 倍

          // 建立動態壓縮器平滑最大振幅，防範爆音與削波失真
          const compressor = audioCtx.createDynamicsCompressor();
          compressor.threshold.setValueAtTime(-24, audioCtx.currentTime);
          compressor.knee.setValueAtTime(30, audioCtx.currentTime);
          compressor.ratio.setValueAtTime(12, audioCtx.currentTime);
          compressor.attack.setValueAtTime(0.003, audioCtx.currentTime);
          compressor.release.setValueAtTime(0.25, audioCtx.currentTime);

          source.connect(gainNode);
          gainNode.connect(compressor);
          compressor.connect(audioCtx.destination);
          source.start(0);
        }

        // 首次點擊網頁任意位置自動觸發預載入解碼，並自動移除自身
        function initOnFirstClick() {
          initWebAudioSfx();
          document.removeEventListener("click", initOnFirstClick);
        }

        // 具名全域事件代理監聽器，防止 Astro ViewTransitions 跳轉頁面時重複綁定
        function globalClickListener(e) {
          const target = e.target;
          if (!target) return;

          const clickable = target.closest(
            "a, button, .scroll-card, .member-card, .ink-expand-btn",
          );
          if (!clickable) return;

          // 1. 壞連結 / 未登記設定 (LowVoice)
          if (clickable.classList.contains("broken-link")) {
            playClickSfx("low");
            return;
          }

          // 2. 展開 / 收合 / 特殊開關 (HighVoice)
          if (
            clickable.id === "toggle-members-btn" ||
            clickable.id === "music-toggle" ||
            clickable.classList.contains("ink-expand-btn")
          ) {
            playClickSfx("high");
            return;
          }

          // 3. 一般點擊 (Click2)
          playClickSfx("normal");
        }

        function setupGlobalClickSfx() {
          // 每次加載頁面時，先移除舊的監聽器，再重新綁定，徹底防範換頁失效與重疊
          document.removeEventListener("click", globalClickListener);
          document.removeEventListener("click", initOnFirstClick);

          document.addEventListener("click", globalClickListener);
          document.addEventListener("click", initOnFirstClick);
        }

        // --- 全站原創正文防複製與版權保護機制 (1秒冷卻防抖) ---
        let lastToastTime = 0;
        const TOAST_COOLDOWN = 1000;

        function showCopyrightToast() {
          const now = Date.now();
          if (now - lastToastTime < TOAST_COOLDOWN) return;
          lastToastTime = now;

          const toast = document.getElementById("ink-toast");
          if (!toast) return;

          toast.classList.add("show");
          setTimeout(() => {
            toast.classList.remove("show");
          }, 2200);
        }

        function isProtectedTarget(targetEl) {
          if (!targetEl) return false;
          // 豁免白名單：輸入框、代碼區塊、按鈕、管理員後台、Giscus 留言區、頁首導覽列
          if (
            targetEl.closest(
              "pre, code, input, textarea, select, [contenteditable='true'], #giscus-container, #giscus-container *, .site-header, .site-footer, .admin-login-btn, .admin-logout-btn, a, button"
            )
          ) {
            return false;
          }
          // 受保護區域：小說正文、設定集、國學筆記、部落格文章、關於我回答
          if (
            targetEl.closest(
              ".markdown-body, .post-markdown-body, .about-card .answer, .content-card, .post-content-card"
            )
          ) {
            return true;
          }
          return false;
        }

        function globalContextMenuListener(e) {
          if (isProtectedTarget(e.target)) {
            e.preventDefault();
            showCopyrightToast();
          }
        }

        function globalCopyListener(e) {
          const selection = window.getSelection();
          const selectedNode =
            selection && selection.anchorNode
              ? selection.anchorNode.parentElement
              : null;
          if (isProtectedTarget(e.target) || isProtectedTarget(selectedNode)) {
            e.preventDefault();
            showCopyrightToast();
          }
        }

        function globalKeyDownListener(e) {
          const isCtrlOrCmd = e.ctrlKey || e.metaKey;
          if (!isCtrlOrCmd) return;
          const key = (e.key || "").toLowerCase();
          // 攔截 Ctrl+C, Ctrl+A, Ctrl+U, Ctrl+S
          if (key === "c" || key === "a" || key === "u" || key === "s") {
            const selection = window.getSelection();
            const selectedNode =
              selection && selection.anchorNode
                ? selection.anchorNode.parentElement
                : null;
            if (
              isProtectedTarget(document.activeElement) ||
              isProtectedTarget(e.target) ||
              isProtectedTarget(selectedNode)
            ) {
              e.preventDefault();
              showCopyrightToast();
            }
          }
        }

        function globalDragStartListener(e) {
          if (isProtectedTarget(e.target)) {
            e.preventDefault();
          }
        }

        function setupAntiCopyProtection() {
          document.removeEventListener("contextmenu", globalContextMenuListener);
          document.removeEventListener("copy", globalCopyListener);
          document.removeEventListener("keydown", globalKeyDownListener);
          document.removeEventListener("dragstart", globalDragStartListener);

          document.addEventListener("contextmenu", globalContextMenuListener);
          document.addEventListener("copy", globalCopyListener);
          document.addEventListener("keydown", globalKeyDownListener);
          document.addEventListener("dragstart", globalDragStartListener);
        }

        function initAdminNav() {
          checkAdminStatus();
          setupLogout();
          initScrollTracker();
          setupGlobalClickSfx();
          setupAntiCopyProtection();
        }

        document.addEventListener("astro:page-load", initAdminNav);
        initAdminNav();
      </script>

      <!-- 主要內容區域 -->
      <main class="site-main">
        <slot />
      </main>

      <!-- 頁尾 -->
      <footer class="site-footer">
        <div class="footer-content">
          <p>© {new Date().getFullYear()} 吃墨水的晚餐 · 晚餐後的書桌 | <a href={`${import.meta.env.BASE_URL}copyright`} style="color: inherit; text-decoration: underline;">版權與使用條款</a> | <a href="https://github.com/meng10730" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: underline;">GitHub</a> · All Rights Reserved.</p>
        </div>
      </footer>
    </div>

    <!-- 古風背景音樂播放器 -->
    <AudioPlayer />

    <!-- 全站百科懸浮氣泡 -->
    <GlossaryPopover />

    <!-- 水墨風防複製提示框 -->
    <div id="ink-toast" class="ink-toast-container" aria-live="polite">
      <span class="ink-toast-icon">印</span>
      <span class="ink-toast-text">手下留情，本站原創內容版權所有，嚴禁複製轉載</span>
    </div>

    <script>
      import { gsap } from "gsap";

      function initGlobalMotionState() {
        // 從 localStorage 同步狀態至 body 和 gsap
        const motionEnabled =
          localStorage.getItem("global_motion_enabled") !== "false";
        if (motionEnabled) {
          document.body.classList.remove("no-motion");
          gsap.globalTimeline.timeScale(1);
        } else {
          document.body.classList.add("no-motion");
          gsap.globalTimeline.timeScale(9999);
        }
      }

      function initAnimations() {
        const motionEnabled =
          localStorage.getItem("global_motion_enabled") !== "false";
        if (!motionEnabled) {
          // 動畫關閉時，直接設定最終狀態，防止頁面加載時的布局與字體抖動
          gsap.set(".site-main", {
            opacity: 1,
            y: 0,
            clearProps: "transform,opacity",
          });
          gsap.set(".nav-links li", {
            opacity: 1,
            y: 0,
            clearProps: "transform,opacity",
          });
          return;
        }

        // 1. 頂部選單的極簡交錯滑動淡入 (Staggered Menu Entrance)
        gsap.from(".nav-links li", {
          opacity: 0,
          y: -5,
          duration: 0.4,
          stagger: 0.04,
          ease: "power1.out",
          clearProps: "transform,opacity",
        });

        // 2. 極簡內容分層漸現動畫 (位移與透明度)，只清除 transform 與 opacity 屬性，保障原生排版樣式不被擦除
        // 優先淡入主標題
        gsap.from(".site-main h1, .site-main .main-title", {
          y: 8,
          opacity: 0,
          duration: 0.5,
          ease: "power2.out",
          clearProps: "transform,opacity",
        });

        // 隨後淡入其餘內容
        gsap.from(".site-main > *:not(h1):not(.main-title)", {
          y: 12,
          opacity: 0,
          duration: 0.5,
          delay: 0.12,
          ease: "power2.out",
          clearProps: "transform,opacity",
        });
      }

      function setupMotionAll() {
        initGlobalMotionState();
        initAnimations();
      }

      // 監聽 Astro 路由載入事件，確保單頁切換時同樣生效
      document.addEventListener("astro:page-load", setupMotionAll);
    </script>
  </body>
</html>

